class Unrun(Exception):
    """Verification could not finish."""


class Fail(Exception):
    """The selected CI run completed with a real failure."""


class Runner:
    def __init__(self) -> None:
        self.procs: list[subprocess.Popen[str]] = []
        self.lock = threading.Lock()
        self.stop = threading.Event()
        self.cleaning = False
        self.interrupt_name = ""

    def handle_signal(self, signum: int, _frame: Any) -> None:
        name = signal.Signals(signum).name
        self.interrupt_name = name
        self.stop.set()
        if not self.cleaning:
            self.kill_children()

    def add(self, proc: subprocess.Popen[str]) -> None:
        with self.lock:
            self.procs.append(proc)

    def drop(self, proc: subprocess.Popen[str]) -> None:
        with self.lock:
            if proc in self.procs:
                self.procs.remove(proc)

    def kill_children(self, grace: float = 1.5) -> None:
        with self.lock:
            procs = list(self.procs)
        for proc in procs:
            _terminate_group(proc, grace)
        with self.lock:
            self.procs = [proc for proc in self.procs if proc.poll() is None]


def _terminate_group(proc: subprocess.Popen[str], grace: float) -> None:
    if proc.poll() is not None:
        return
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError, OSError):
        try:
            proc.terminate()
        except (ProcessLookupError, PermissionError, OSError):
            return
    deadline = time.monotonic() + max(0.05, grace)
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            return
        time.sleep(0.05)
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        try:
            proc.kill()
        except (ProcessLookupError, PermissionError, OSError):
            pass
    try:
        proc.wait(timeout=1)
    except subprocess.TimeoutExpired:
        pass


def env_seconds(name: str, default: float) -> float:
    raw = os.environ.get(name, "").strip()
    if not raw:
        return default
    try:
        value = float(raw)
    except ValueError as error:
        raise Unrun(f"{name} must be a positive finite number, got {raw!r}") from error
    if not math.isfinite(value) or value <= 0:
        raise Unrun(f"{name} must be a positive finite number, got {raw!r}")
    return value


def load_deadlines() -> dict[str, float]:
    return {
        "discovery": env_seconds("BOB_MACOS_CI_DISCOVERY_SECONDS", 300),
        "total": env_seconds("BOB_MACOS_CI_TOTAL_SECONDS", 5400),
        "command": env_seconds("BOB_MACOS_CI_COMMAND_SECONDS", 60),
        "cleanup": env_seconds("BOB_MACOS_CI_CLEANUP_SECONDS", 120),
        "poll": env_seconds("BOB_MACOS_CI_POLL_SECONDS", 10),
    }


MIN_COMMAND_SECONDS = 1.0
# GitHub can mark a run completed while its jobs still read in_progress; poll
# this many more times (capped by the total deadline) for them to catch up.
JOB_SETTLE_POLLS = 12


def remaining(deadline: float) -> float:
    return deadline - time.monotonic()


def command_timeout(deadlines: dict[str, float], deadline: float) -> float:
    left = remaining(deadline)
    if left <= 0:
        raise Unrun("deadline reached before starting an external command")
    spawn = min(MIN_COMMAND_SECONDS, deadlines["command"])
    timeout = min(deadlines["command"], left)
    if timeout < spawn:
        raise Unrun("deadline reached before starting an external command")
    return timeout


def sleep_for(runner: Runner, seconds: float, deadline: float) -> None:
    end = min(time.monotonic() + max(0.0, seconds), deadline)
    while time.monotonic() < end:
        if runner.stop.is_set() and not runner.cleaning:
            raise Unrun(_interrupt_message(runner))
        if runner.cleaning:
            time.sleep(min(0.1, end - time.monotonic()))
        else:
            runner.stop.wait(min(0.1, end - time.monotonic()))
    if runner.stop.is_set() and not runner.cleaning:
        raise Unrun(_interrupt_message(runner))


def _interrupt_message(runner: Runner) -> str:
    name = runner.interrupt_name or "signal"
    return f"interrupted by {name}"


def child_env(index_file: str | None = None) -> dict[str, str]:
    env = os.environ.copy()
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["GIT_ASKPASS"] = ""
    env["SSH_ASKPASS"] = ""
    env["GCM_INTERACTIVE"] = "never"
    env["GIT_PAGER"] = "cat"
    env["GH_PAGER"] = "cat"
    env["GH_PROMPT_DISABLED"] = "1"
    env["PAGER"] = "cat"
    # gh 2.103 still colorizes --json when CLICOLOR_FORCE/FORCE_COLOR is set,
    # even with a pipe and NO_COLOR=1. Parent agent shells often export both.
    env["NO_COLOR"] = "1"
    env["CLICOLOR"] = "0"
    env["CLICOLOR_FORCE"] = "0"
    env["FORCE_COLOR"] = "0"
    env.pop("GH_FORCE_TTY", None)
    if index_file:
        env["GIT_INDEX_FILE"] = index_file
    elif "GIT_INDEX_FILE" in env:
        del env["GIT_INDEX_FILE"]
    return env


def which_or_unrun(name: str) -> str:
    path = shutil.which(name)
    if not path:
        raise Unrun(f"required command not found on PATH: {name}")
    return path


def run_command(
    runner: Runner,
    argv: list[str],
    *,
    timeout: float,
    cwd: Path | None = None,
    index_file: str | None = None,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    if runner.stop.is_set() and not runner.cleaning:
        raise Unrun(_interrupt_message(runner))
    merged = child_env(index_file)
    if env:
        merged.update(env)
    try:
        proc = subprocess.Popen(
            argv,
            cwd=str(cwd) if cwd else None,
            env=merged,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
    except OSError as error:
        raise Unrun(f"could not start {argv[0]}: {error}") from error
    runner.add(proc)
    try:
        stdout, stderr = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired as error:
        _terminate_group(proc, grace=1.0)
        try:
            stdout, stderr = proc.communicate(timeout=1)
        except subprocess.TimeoutExpired:
            stdout, stderr = "", ""
        raise Unrun(
            f"command timed out after {timeout:.1f}s: {format_cmd(argv)}"
        ) from error
    finally:
        runner.drop(proc)
    if runner.stop.is_set() and not runner.cleaning:
        raise Unrun(_interrupt_message(runner))
    return subprocess.CompletedProcess(argv, proc.returncode, stdout, stderr)


def format_cmd(argv: list[str]) -> str:
    return " ".join(shlex.quote(part) for part in argv)


def log(message: str) -> None:
