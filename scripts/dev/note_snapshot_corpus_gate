#!/usr/bin/env bash
set -uo pipefail

usage() {
    cat <<'EOF'
Render every root area/project note and dry-run every vault Markdown note.

Usage: scripts/dev/note_snapshot_corpus_gate [BOB_DIR] [OUTPUT_DIR]

BOB_DIR defaults to $BOB_DIR or ~/bob. OUTPUT_DIR defaults to a new directory
under ${TMPDIR:-/tmp}; it must be outside the vault and empty if it exists.
Set BOB_BIN to choose the bob executable (defaults to bob).
EOF
}

fail() {
    printf 'note-snapshot-corpus-gate: error: %s\n' "$*" >&2
    exit 2
}

if [[ ${1-} == -h || ${1-} == --help ]]; then
    usage
    exit 0
fi
(( $# <= 2 )) || { usage >&2; exit 2; }

bob_dir=${1:-${BOB_DIR:-$HOME/bob}}
bob_bin=${BOB_BIN:-bob}

[[ -d $bob_dir ]] || fail "vault directory does not exist: $bob_dir"
bob_dir=$(cd -P -- "$bob_dir" && pwd) || fail "cannot resolve vault directory"

if [[ -n ${2-} ]]; then
    out_dir=$2
    mkdir -p -- "$out_dir" || fail "cannot create output directory: $out_dir"
else
    out_dir=$(mktemp -d "${TMPDIR:-/tmp}/bob-note-snapshot-gate.XXXXXX") || fail "cannot create scratch output directory"
fi
out_dir=$(cd -P -- "$out_dir" && pwd) || fail "cannot resolve output directory"
case "$out_dir/" in
    "$bob_dir/"*) fail "output directory must be outside the vault: $out_dir" ;;
esac
[[ -z $(find "$out_dir" -mindepth 1 -maxdepth 1 -print -quit) ]] || fail "output directory must be empty: $out_dir"

command -v "$bob_bin" >/dev/null 2>&1 || fail "bob executable not found: $bob_bin"
for tool in git awk find grep pdffonts pdfinfo pdftoppm python3; do
    command -v "$tool" >/dev/null 2>&1 || fail "required command not found: $tool"
done
git -C "$bob_dir" rev-parse --show-toplevel >/dev/null 2>&1 || fail "vault is not a git checkout: $bob_dir"

mkdir -p "$out_dir/logs" "$out_dir/pages"
summary="$out_dir/summary.md"
before_status="$out_dir/vault-status.before"
after_status="$out_dir/vault-status.after"
git -C "$bob_dir" status --porcelain --untracked-files=all >"$before_status" || fail "cannot read vault git status"

declare -a render_notes=()
declare -a render_rows=()
declare -a dry_rows=()
declare -a render_warnings=()
declare -a dry_warnings=()
declare -a dry_warning_explanations=()
declare -a type3_details=()
declare -a residue_details=()
render_failures=0
dry_failures=0
missing_glyph_warnings=0
overfull_warnings=0
type3_fonts=0
dry_unresolved=0
dry_parent_fallbacks=0
dry_name_fallbacks=0
status_chip_rows=0
raw_block_id_labels=0
task_rows_with_blank_line=0
false_heading_warnings=0
false_file_warnings=0
residue_scan_failures=0
dry_run_parent=

declare -A vault_file_set=()
declare -A vault_basename_counts=()
while IFS= read -r -d '' path; do
    rel=${path#"$bob_dir"/}
    vault_file_set["$rel"]=1
    basename=${rel##*/}
    basename_key=${basename,,}
    vault_basename_counts["$basename_key"]=$(( ${vault_basename_counts[$basename_key]:-0} + 1 ))
done < <(find "$bob_dir" \( -type d -name '.*' -prune \) -o \( \( -type f -o -type l \) -print0 \))

frontmatter_kind() {
    awk '
        NR == 1 && $0 ~ /^---[[:space:]]*$/ { frontmatter = 1; next }
        frontmatter && $0 ~ /^---[[:space:]]*$/ { exit }
        frontmatter && $0 ~ /^[[:space:]]*type:[[:space:]]*/ {
            value = $0
            sub(/^[[:space:]]*type:[[:space:]]*/, "", value)
            sub(/[[:space:]]+#.*/, "", value)
            gsub(/["\047[:space:]]/, "", value)
            if (value == "[[area]]" || value == "[[project]]") {
                print value
                exit
            }
        }
    ' "$1"
}

markdown_cell() {
    local value=${1//$'\n'/<br>}
    value=${value//|/\\|}
    printf '%s' "$value"
}

vault_file_match=
find_vault_file_match() {
    local target=$1 source_rel=${2-} candidate base basename_key count
    local source_dir extension
    vault_file_match=
    target=${target#./}
    if [[ $target == "$bob_dir/"* ]]; then
        target=${target#"$bob_dir"/}
    fi
    for candidate in "$target" "$target.md"; do
        if [[ -n ${vault_file_set[$candidate]-} ]]; then
            vault_file_match="exact path $candidate"
            return 0
        fi
    done
    if [[ -n $source_rel ]]; then
        source_dir=${source_rel%/*}
        [[ $source_dir == "$source_rel" ]] && source_dir=.
        for candidate in "$source_dir/$target" "$source_dir/$target.md"; do
            if [[ -n ${vault_file_set[$candidate]-} ]]; then
                vault_file_match="source-relative path $candidate"
                return 0
            fi
        done
    fi
    # After exact and source-relative misses, the last path component uses
    # the same case-insensitive basename rules as a bare target: Markdown
    # names with or without .md, other files with their extension, unique
    # non-dot-directory candidates. Directory-qualified Markdown follows
    # VaultLinkResolver's final-component fallback.
    base=${target##*/}
    [[ -n $base ]] || return 1
    extension=${base##*.}
    if [[ $base == *.* && ${extension,,} != md ]]; then
        candidate=$base
    else
        candidate=$base
        [[ ${extension,,} == md ]] || candidate="$candidate.md"
    fi
    basename_key=${candidate,,}
    count=${vault_basename_counts[$basename_key]:-0}
    if [[ $count == 1 ]]; then
        vault_file_match="unique basename $candidate"
        return 0
    fi
    if [[ $count != 0 ]]; then
        vault_file_match="ambiguous basename $candidate"
    fi
    return 1
}

scan_render_residue() {
    python3 - "$1" "$2" <<'PY'
import re
import sys
from pathlib import Path

projected = Path(sys.argv[1]).read_text(encoding="utf-8", errors="replace")
tex = Path(sys.argv[2]).read_text(encoding="utf-8", errors="replace")

def strip_code_spans(text):
    out = []
    i = 0
    while i < len(text):
        if text[i] != "`":
            out.append(text[i])
            i += 1
            continue
        end = i + 1
        while end < len(text) and text[end] == "`":
            end += 1
        width = end - i
        search = end
        closing = None
        while search < len(text):
            tick = text.find("`", search)
            if tick < 0:
                break
            tick_end = tick + 1
            while tick_end < len(text) and text[tick_end] == "`":
                tick_end += 1
            if tick_end - tick == width:
                closing = tick_end
                break
            search = tick_end
        if closing is None:
            out.append(text[i:end])
            i = end
        else:
            out.append(" ")
            i = closing
    return "".join(out)

markdown_text = strip_code_spans(projected)
markdown_text = re.sub(r"!?\[([^\]]*)\]\((?:<[^>]*>|[^)]*)\)", r"\1", markdown_text)
raw_ids = len(re.findall(r"\^[A-Za-z0-9-]+", markdown_text))
blank_task_rows = len(re.findall(
    r"\\BobTask\{[^}]*\}[ \t]*\r?\n[ \t]*\r?\n", tex
))
print(f"{raw_ids}\t{blank_task_rows}")
PY
}

heading_exists() {
    python3 - "$1" "$2" <<'PY'
import re
import sys
from pathlib import Path
from urllib.parse import unquote

path, target = sys.argv[1:]
fragment = unquote(target.rsplit("#", 1)[-1]).strip()
try:
    lines = Path(path).read_text(encoding="utf-8", errors="replace").splitlines()
except OSError:
    raise SystemExit(0)

def slug(value):
    value = re.sub(r"`([^`]*)`", r"\1", value)
    value = re.sub(r"\{#[^}]+\}\s*$", "", value)
    value = value.lower()
    value = re.sub(r"[^\w -]", "", value, flags=re.UNICODE)
    return re.sub(r"\s+", "-", value.strip())

fragment_key = fragment.lower()
fragment_slug = slug(fragment)
frontmatter = bool(lines and re.match(r"^---\s*$", lines[0]))
in_fence = None
headings = []
for number, line in enumerate(lines):
    if frontmatter:
        if number > 0 and re.match(r"^---\s*$", line):
            frontmatter = False
        continue
    fence = re.match(r"^ {0,3}(`{3,}|~{3,})", line)
    if in_fence:
        if fence and fence.group(1)[0] == in_fence[0] and len(fence.group(1)) >= len(in_fence):
            in_fence = None
        continue
    if fence:
        in_fence = fence.group(1)
        continue
    heading = re.match(r"^ {0,3}#{1,6}[ \t]+(.+?)\s*#*\s*$", line)
    if not heading:
        continue
    title = heading.group(1).strip()
    explicit = re.search(r"\{#([^}]+)\}\s*$", title)
    explicit_id = explicit.group(1) if explicit else None
    if explicit:
        title = title[:explicit.start()].rstrip()
    headings.append((title, explicit_id))

for title, explicit_id in headings:
    if fragment_key == title.lower() or (explicit_id and fragment == explicit_id):
        raise SystemExit(0)
    if fragment_slug and fragment_slug == slug(title):
        raise SystemExit(0)
raise SystemExit(1)
PY
}

dry_warning_explanation() {
    local warning=$1
    local source_rel=${2-}
    local target=
    case "$warning" in
        *"no file or vault note named '"*|*"no vault attachment named '"*)
            target=${warning#*named \'}
            target=${target%%\'*}
            if find_vault_file_match "$target" "$source_rel"; then
                printf 'FAIL: target matches an existing vault file (%s).' "$vault_file_match"
            elif [[ $vault_file_match == ambiguous* ]]; then
                printf 'Ambiguous: multiple non-dot-directory files share this basename (%s).' "$vault_file_match"
            else
                printf 'Genuinely missing: no exact path, matching .md path, or unique non-dot-directory basename exists.'
            fi ;;
        *"no #"*|*"no ^"*)
            printf 'Source refers to a missing heading or block anchor; the dry run reported the unresolved target.' ;;
        *" headings named "*|*" blocks named "*)
            printf 'Duplicate anchors make this heading or block reference ambiguous; the source remains unchanged.' ;;
        *"cyclic embed"*|*"not following nested embed "*|*"not following cyclic nested embed "*)
            printf 'The nested embed was not followed to prevent recursion or unbounded expansion; the dry run reported the omission.' ;;
        *"not including "*"selected content is "*" limits:"*)
            printf 'Selected embed content exceeded the configured size or line bound and was omitted; the dry run reported the limit.' ;;
        *"cannot include "*)
            printf 'The embed was omitted to avoid recursion or an unavailable source; the dry run reported the omission.' ;;
        *"unknown task status "*)
            printf 'The source uses an unknown task marker; Bob reports it and treats the row as open.' ;;
        *"uncovered glyphs: U+FE0F"*)
            printf 'This is the U+FE0F emoji variation selector, which the print Lua filter intentionally removes.' ;;
        *"uncovered glyph "*)
            printf 'The source contains a glyph outside the print coverage report; dry runs do not render a PDF.' ;;
        *)
            printf 'Retained for manual review; no vault content was changed.' ;;
    esac
}

note_index=0
while IFS= read -r -d '' note; do
    kind=$(frontmatter_kind "$note")
    [[ -n $kind ]] || continue
    rel=${note#"$bob_dir"/}
    render_notes+=("$rel")
done < <(find "$bob_dir" -maxdepth 1 -type f -name '*.md' -print0 | sort -z)

((${#render_notes[@]} > 0)) || fail "no root area/project notes found in $bob_dir"

# Ordinary notes without a usable parent still need one for a complete dry-run.
# Keep the note's own/ancestor default under test first; retry only the notes for
# which the CLI correctly reports that it cannot infer an eligible parent.
for rel in "${render_notes[@]}"; do
    if [[ $(frontmatter_kind "$bob_dir/$rel") == '[[area]]' ]]; then
        dry_run_parent=${rel%.md}
        break
    fi
done
if [[ -z $dry_run_parent ]]; then
    for rel in "${render_notes[@]}"; do
        dry_run_parent=${rel%.md}
        break
    done
fi

printf 'Rendering %d root area/project notes; dry-running all vault Markdown notes.\n' "${#render_notes[@]}"
printf 'Scratch output: %s\n' "$out_dir"

for rel in "${render_notes[@]}"; do
    ((note_index += 1))
    note="$bob_dir/$rel"
    stem=${rel##*/}
    stem=${stem%.md}
    pdf="$out_dir/$stem.pdf"
    log="$out_dir/logs/render-$(printf '%04d' "$note_index").log"
    start_seconds=$SECONDS
    status=0
    BOB_HIGHLIGHTS_KEEP_WORKDIR=1 "$bob_bin" ref create "$note" --output "$pdf" --no-audio --bob-dir "$bob_dir" >"$log" 2>&1 || status=$?
    elapsed=$((SECONDS - start_seconds))
    warning_text=$(grep -i 'warning:' "$log" || true)
    while IFS= read -r line; do
        [[ -n $line ]] || continue
        render_warnings+=("$rel: $line")
        [[ $line == *"missing glyph:"* ]] && ((missing_glyph_warnings += 1))
        [[ $line == *"overfull:"* ]] && ((overfull_warnings += 1))
        if [[ $line == *"local link "* && $line == *" has no target; rendered as plain text"* ]] &&
            [[ $line =~ local\ link\ ([^[:space:]]+)\ \( ]] &&
            heading_exists "$note" "${BASH_REMATCH[1]}"; then
            ((false_heading_warnings += 1))
            residue_details+=("$rel: local-link warning points to an existing heading")
        fi
    done <<<"$warning_text"

    workdir=$(sed -n 's/^workdir: //p' "$log" | tail -n 1)
    if [[ -z $workdir || ! -d $workdir ]]; then
        ((residue_scan_failures += 1))
        residue_details+=("$rel: retained render workdir was not reported")
    else
        tmp_root=$(cd -P -- "${TMPDIR:-/tmp}" 2>/dev/null && pwd || true)
        case "$workdir/" in
            "$tmp_root/"*|"/tmp/bob-create-"*)
                projected="$workdir/projected.md"
                tex="$workdir/note.tex"
                if [[ -f $projected && -f $tex ]]; then
                    badge_count=$(grep -Ec '^[[:space:]]*\[.*⚪[[:space:]]*[0-9]+[[:space:]]+open.*\]' "$projected" || true)
                    ((status_chip_rows += badge_count))
                    ((badge_count == 0)) || residue_details+=("$rel: $badge_count status-chip row(s)")
                    residue_counts=$(scan_render_residue "$projected" "$tex") || residue_counts=
                    if [[ $residue_counts =~ ^([0-9]+)[[:space:]]+([0-9]+)$ ]]; then
                        raw_count=${BASH_REMATCH[1]}
                        task_gap_count=${BASH_REMATCH[2]}
                        ((raw_block_id_labels += raw_count))
                        ((task_rows_with_blank_line += task_gap_count))
                        ((raw_count == 0)) || residue_details+=("$rel: $raw_count raw block-ID label(s) outside code")
                        ((task_gap_count == 0)) || residue_details+=("$rel: $task_gap_count task row(s) separated from text by a blank line")
                    else
                        ((residue_scan_failures += 1))
                        residue_details+=("$rel: could not parse residue scan results")
                    fi
                else
                    ((residue_scan_failures += 1))
                    residue_details+=("$rel: retained workdir is missing projected.md or note.tex")
                fi
                rm -rf -- "$workdir"
                ;;
            *)
                ((residue_scan_failures += 1))
                residue_details+=("$rel: retained workdir is outside the configured temporary directory")
                ;;
        esac
    fi

    pages=0
    fonts_status=unavailable
    if (( status == 0 )) && [[ -f $pdf ]]; then
        pages=$(pdfinfo "$pdf" 2>/dev/null | awk -F: '/^Pages:/ {gsub(/[[:space:]]/, "", $2); print $2; exit}')
        pages=${pages:-0}
        if [[ $pages == 0 ]]; then
            status=1
        fi
        fonts_log="$out_dir/logs/fonts-$(printf '%04d' "$note_index").log"
        if (( status == 0 )) && pdffonts "$pdf" >"$fonts_log" 2>&1; then
            fonts_status=clean
            while IFS= read -r font_line; do
                [[ $font_line == *"Type 3"* ]] || continue
                ((type3_fonts += 1))
                type3_details+=("$rel: $font_line")
                fonts_status=Type-3
            done <"$fonts_log"
        elif (( status == 0 )); then
            fonts_status=failed
            status=1
        fi
        prefix="$out_dir/pages/$stem"
        if (( status == 0 )) && ! pdftoppm -f 1 -l 2 -png -r 110 "$pdf" "$prefix" >"$out_dir/logs/pages-$(printf '%04d' "$note_index").log" 2>&1; then
            status=1
        fi
    else
        status=1
    fi
    (( status == 0 )) || ((render_failures += 1))
    warnings_cell=$(markdown_cell "$warning_text")
    render_rows+=("| $(markdown_cell "$rel") | $status | $pages | ${elapsed}s | $fonts_status | ${warnings_cell:-—} |")
    if (( status == 0 )); then
        printf '  rendered %s (%s pages, %ss, %s fonts)\n' "$rel" "$pages" "$elapsed" "$fonts_status"
    else
        printf '  FAILED  %s (exit %s; see %s)\n' "$rel" "$status" "$log" >&2
    fi
done

dry_index=0
while IFS= read -r -d '' note; do
    ((dry_index += 1))
    rel=${note#"$bob_dir"/}
    log="$out_dir/logs/dry-run-$(printf '%05d' "$dry_index").log"
    status=0
    used_parent_fallback=0
    "$bob_bin" ref create "$note" --dry-run --bob-dir "$bob_dir" >"$log" 2>&1 || status=$?
    if (( status != 0 )) && grep -Fq -- '--parent is required' "$log"; then
        retry_log="$log.retry"
        retry_status=0
        "$bob_bin" ref create "$note" --dry-run --bob-dir "$bob_dir" --parent "$dry_run_parent" >"$retry_log" 2>&1 || retry_status=$?
        if (( retry_status == 0 )); then
            {
                printf 'Corpus dry-run parent fallback: -P %s (no eligible parent inferred).\n' "$dry_run_parent"
                cat "$retry_log"
            } >"$log"
            status=0
            used_parent_fallback=1
            ((dry_parent_fallbacks += 1))
        else
            {
                cat "$log"
                printf '\nCorpus dry-run parent fallback failed: -P %s (exit %s).\n' "$dry_run_parent" "$retry_status"
                cat "$retry_log"
            } >"$log.failed"
            mv -- "$log.failed" "$log"
            status=$retry_status
        fi
        rm -f -- "$retry_log"
    fi
    dry_name=${rel##*/}
    dry_name=${dry_name%.md}_corpus_gate
    if (( status != 0 )) && grep -Eiq -- 'already (queued|captured)' "$log"; then
        retry_log="$log.retry"
        retry_status=0
        retry_args=(ref create "$note" --dry-run --bob-dir "$bob_dir" --name "$dry_name")
        if (( used_parent_fallback )); then
            retry_args+=(--parent "$dry_run_parent")
        fi
        "$bob_bin" "${retry_args[@]}" >"$retry_log" 2>&1 || retry_status=$?
        if (( retry_status == 0 )); then
            {
                printf 'Corpus dry-run name fallback: -N %s (default name already exists).\n' "$dry_name"
                cat "$retry_log"
            } >"$log"
            status=0
            ((dry_name_fallbacks += 1))
        else
            {
                cat "$log"
                printf '\nCorpus dry-run name fallback failed: -N %s (exit %s).\n' "$dry_name" "$retry_status"
                cat "$retry_log"
            } >"$log.failed"
            mv -- "$log.failed" "$log"
            status=$retry_status
        fi
        rm -f -- "$retry_log"
    fi
    warning_text=$(grep -i 'warning:' "$log" || true)
    while IFS= read -r line; do
        [[ -n $line ]] || continue
        explanation=$(dry_warning_explanation "$line" "$rel")
        dry_warnings+=("$rel: $line")
        dry_warning_explanations+=("$explanation")
        case "$line" in
            *"no file or vault note named "*|*"no vault attachment named "*|*"no #"*|*"no ^"*|*"unresolved"*|*"not found"*)
                ((dry_unresolved += 1)) ;;
        esac
        if [[ $explanation == FAIL:* ]]; then
            ((false_file_warnings += 1))
            match_kind=${explanation#*existing vault file (}
            match_kind=${match_kind%)*}
            residue_details+=("$rel: unresolved warning names an existing vault file ($match_kind)")
        fi
    done <<<"$warning_text"
    (( status == 0 )) || ((dry_failures += 1))
    dry_rows+=("| $(markdown_cell "$rel") | $status | $(markdown_cell "$warning_text") |")
    if (( status != 0 )); then
        printf '  dry-run FAILED %s (exit %s; see %s)\n' "$rel" "$status" "$log" >&2
    fi
done < <(find "$bob_dir" \
    \( -type d \( -name '.*' -o -name '_conflicts' -o -name '_generated' -o -name '_templates' -o -name 'xlib' -o -name 'lib' -o -name 'lit_review' \) -prune \) -o \
    \( -type f -name '*.md' ! -name '.md' -print0 \))

git -C "$bob_dir" status --porcelain --untracked-files=all >"$after_status" || fail "cannot read vault git status after gate"
vault_status_clean=yes
if ! cmp -s "$before_status" "$after_status"; then
    vault_status_clean=no
fi

cat >"$summary" <<EOF
# Note snapshot corpus gate

- Vault: \`$bob_dir\`
- Output: \`$out_dir\`
- Area/project notes rendered: ${#render_notes[@]}
- Markdown notes dry-run: $dry_index
- Render failures: $render_failures
- Dry-run failures: $dry_failures
- Missing-glyph warnings: $missing_glyph_warnings
- Overfull warnings: $overfull_warnings
- Type 3 fonts: $type3_fonts
- Unresolved-reference warnings in dry runs (review each entry): $dry_unresolved
- Status-chip rows in projected Markdown: $status_chip_rows
- Raw block-ID labels outside code spans: $raw_block_id_labels
- Task rows with a blank line before their text: $task_rows_with_blank_line
- False local-heading warnings: $false_heading_warnings
- False unresolved file warnings: $false_file_warnings
- Residue scan failures: $residue_scan_failures
- Dry-run parent fallbacks: $dry_parent_fallbacks (route: \`$dry_run_parent\`)
- Dry-run same-day name fallbacks: $dry_name_fallbacks
- Vault git status unchanged: $vault_status_clean

## Render results

| Note | Exit | Pages | Seconds | Fonts | Warnings |
| --- | ---: | ---: | ---: | --- | --- |
EOF
printf '%s\n' "${render_rows[@]}" >>"$summary"

cat >>"$summary" <<'EOF'

## Render warning details

EOF
if ((${#render_warnings[@]})); then
    for line in "${render_warnings[@]}"; do
        printf -- '- %s\n' "$(markdown_cell "$line")" >>"$summary"
    done
else
    printf -- '- None.\n' >>"$summary"
fi

cat >>"$summary" <<'EOF'

## Dry-run results

| Note | Exit | Warnings |
| --- | ---: | --- |
EOF
printf '%s\n' "${dry_rows[@]}" >>"$summary"

cat >>"$summary" <<'EOF'

## Dry-run warning details

Each unresolved file warning is checked against exact paths, source-relative paths, the
corresponding `.md` path, and unique non-dot-directory basenames, including the last
component of a directory-qualified target. Targets that exist fail the gate; absent
targets are recorded as genuinely missing; ambiguous basenames are reported separately.
Heading and block warnings are retained for review. Do not paste note contents into this
report.

EOF
if ((${#dry_warnings[@]})); then
    idx=0
    for line in "${dry_warnings[@]}"; do
        explanation=${dry_warning_explanations[idx]}
        printf -- '- %s — explanation: %s\n' "$(markdown_cell "$line")" "$explanation" >>"$summary"
        ((idx += 1))
    done
else
    printf -- '- None.\n' >>"$summary"
fi

cat >>"$summary" <<'EOF'

## Residue findings

EOF
if ((${#residue_details[@]})); then
    for line in "${residue_details[@]}"; do
        printf -- '- %s\n' "$(markdown_cell "$line")" >>"$summary"
    done
else
    printf -- '- None.\n' >>"$summary"
fi

if ((${#type3_details[@]})); then
    cat >>"$summary" <<'EOF'

## Type 3 font details

EOF
    for line in "${type3_details[@]}"; do
        printf -- '- %s\n' "$(markdown_cell "$line")" >>"$summary"
    done
fi

printf '\nSummary: %s\n' "$summary"
if [[ $vault_status_clean != yes ]]; then
