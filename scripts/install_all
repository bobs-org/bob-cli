#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/install_all [-h|--help] [-v|--verbose]

Pull and install bob-cli from this checkout, then pull and deploy the sibling
bob-plugins and bob-mac-capture checkouts that live next to it. When a sibling
it would install is missing and the run is interactive, it first asks whether
to clone it over SSH from git@github.com:bobs-org/<repo>.git; otherwise that
sibling is skipped. When the plugin sync changes the vault, a running Obsidian
is then restarted so it loads the new plugins. On macOS it posts a Notification
Center banner before that restart. Usually run through `just install-all`.

Options:
  -h, --help     Show this help and exit.
  -v, --verbose  Stream raw build and plugin-sync output.
EOF
}

verbose_requested=0
while [[ $# -gt 0 ]]; do
  arg="$1"
  shift
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    -v|--verbose)
      verbose_requested=1
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done
if (( verbose_requested )); then
  export BOB_INSTALL_VERBOSE=1
fi

if ! command -v git >/dev/null 2>&1; then
  printf 'scripts/install_all: git is required on PATH\n' >&2
  exit 1
fi
if ! command -v just >/dev/null 2>&1; then
  printf 'scripts/install_all: just is required on PATH\n' >&2
  exit 1
fi

if [[ -n "${BOB_INSTALL_ALL_ELAPSED:-}" ]]; then
  SECONDS="$BOB_INSTALL_ALL_ELAPSED"
else
  SECONDS=0
fi
self_pull_state="${BOB_INSTALL_ALL_SELF_PULL:-}"
self_pull_detail="${BOB_INSTALL_ALL_SELF_PULL_DETAIL:-}"
self_pull_old="${BOB_INSTALL_ALL_SELF_PULL_OLD:-}"
self_pull_new="${BOB_INSTALL_ALL_SELF_PULL_NEW:-}"
self_pull_protocol="${BOB_INSTALL_ALL_PROTOCOL:-}"
header_done="${BOB_INSTALL_ALL_HEADER_DONE:-}"
clones_offered="${BOB_INSTALL_ALL_CLONES_OFFERED:-}"
plugins_clone_state="${BOB_INSTALL_ALL_PLUGINS_CLONE:-}"
mac_capture_clone_state="${BOB_INSTALL_ALL_MAC_CAPTURE_CLONE:-}"
run_id="${BOB_INSTALL_RUN_ID:-}"
unset BOB_INSTALL_ALL_ELAPSED BOB_INSTALL_ALL_SELF_PULL \
  BOB_INSTALL_ALL_SELF_PULL_DETAIL BOB_INSTALL_ALL_SELF_PULL_OLD \
  BOB_INSTALL_ALL_SELF_PULL_NEW BOB_INSTALL_ALL_PROTOCOL \
  BOB_INSTALL_ALL_HEADER_DONE \
  BOB_INSTALL_ALL_CLONES_OFFERED BOB_INSTALL_ALL_PLUGINS_CLONE \
  BOB_INSTALL_ALL_MAC_CAPTURE_CLONE
if [[ -z "$run_id" ]]; then
  run_id="$(date +%Y%m%d-%H%M%S)-$$"
fi
export BOB_INSTALL_RUN_ID="$run_id"
export BOB_INSTALL_ALL_RUN_ID="$run_id"
# Tells the justfile `install` recipe to skip its nested banner and quiet
# shell completion; every helper call below shares the same run ID.
export BOB_INSTALL_ALL=1
# The orchestrator owns the final interrupt row after the runner restores the terminal.
export BOB_INSTALL_ALL_INTERRUPT_PARENT=1

script_dir="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$script_dir/.." && pwd)"
parent="$(dirname "$root")"
# Best-effort UI helper; every call site below treats a nonzero status as
# "feature unavailable" and continues with today's behavior.
if [[ -f "$root/scripts/lib/install_ui.sh" ]]; then
  # shellcheck disable=SC1091
  source "$root/scripts/lib/install_ui.sh"
fi
# A missing loader degrades to today's behavior: every helper call below
# fails silently and the install continues.
if ! command -v install_ui >/dev/null 2>&1; then
  install_ui() { return 1; }
fi
if ! command -v install_ui_mark_installed >/dev/null 2>&1; then
  install_ui_mark_installed() { return 1; }
fi
if ! command -v install_ui_live_eligible >/dev/null 2>&1; then
  install_ui_live_eligible() { return 1; }
fi
if ! command -v install_ui_run >/dev/null 2>&1; then
  install_ui_run() {
    shift 4
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --crate|--profile|--success-code|--rows-file) shift 2 ;;
        --) shift; break ;;
        *) break ;;
      esac
    done
    "$@"
  }
fi
plugins_dir="$parent/bob-plugins"
mac_capture_dir="$parent/bob-mac-capture"
# Recorded pull results, one set per repo. The header pulls fill them in and
# the steps and the digest consume them; steps never pull again.
cli_pull_state=""; cli_pull_detail=""; cli_pull_output=""
cli_pull_pre=""; cli_pull_post=""
plugins_pull_state=""; plugins_pull_detail=""; plugins_pull_output=""
plugins_pull_pre=""; plugins_pull_post=""
maccap_pull_state=""; maccap_pull_detail=""; maccap_pull_output=""
maccap_pull_pre=""; maccap_pull_post=""
legacy_digest_unavailable=0
clone_base='git@github.com:bobs-org'
obsidian_dir="${BOB_DIR:-$HOME/bob}/.obsidian"
total_start=0
pull_tmp_file=""
active_step=""
active_phase=""
active_step_start=0
PULL_STATE=""
PULL_DETAIL=""
PULL_OUTPUT=""
CLONE_STATE=""
CLONE_SECTION_SHOWN=0
FAILURES=0
WARNINGS=0
PLUGINS_CHANGED=0
# Remembers a restart still owed after a sync that copied files but then
# skipped or failed the Obsidian restart, so a later run retries even when
# the vault is already in sync.
restart_marker="${XDG_STATE_HOME:-$HOME/.local/state}/bob-cli/install-all/obsidian-restart-pending"
declare -a summary_names=()
declare -a summary_glyphs=()
declare -a summary_details=()
declare -a summary_durations=()
declare -a summary_colors=()
ui_state_dir="${BOB_INSTALL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/bob-cli/install-all}"
ui_run_dir="$ui_state_dir/runs/$run_id"
rows_after=0
counting_rows=0

cleanup() {
  if [[ -n "$pull_tmp_file" ]]; then
    rm -f "$pull_tmp_file"
  fi
}
trap cleanup EXIT

if [[ -t 1 && -z "${NO_COLOR+x}" ]]; then
  use_color=1
else
  use_color=0
fi

display_path() {
  local path="$1"
  if [[ "$path" == "$HOME" ]]; then
    printf '%s' '~'
  elif [[ "$path" == "$HOME/"* ]]; then
    printf '%s/%s' '~' "${path#"$HOME"/}"
  else
    printf '%s' "$path"
  fi
}

paint() {
  local color="$1"
  local value="$2"
  if [[ "$use_color" -eq 1 ]]; then
    printf '\033[%sm%s\033[0m' "$color" "$value"
  else
    printf '%s' "$value"
  fi
}

note_rows() {
  local n="$1"
  if (( counting_rows )); then
    rows_after=$((rows_after + n))
  fi
}

note_line() {
  local text="$1"
  local cols="${COLUMNS:-80}"
  local plain n
  plain="$(printf '%s' "$text" | sed $'s/\033\\[[0-9;]*m//g')"
  n=${#plain}
  if (( n < 1 )); then
    note_rows 1
    return 0
  fi
  if (( cols < 1 )); then
    cols=80
  fi
  note_rows $(( (n + cols - 1) / cols ))
}

add_runner_rows() {
  local step="$1" path n
  path="$ui_run_dir/rows-$step"
  [[ -f "$path" ]] || return 0
  n="$(cat "$path" 2>/dev/null || true)"
  if [[ "$n" =~ ^[0-9]+$ ]]; then
    note_rows "$n"
  fi
}

banner() {
  local color="$1"
  local icon="$2"
  local title="$3"
  # Keep this 48-character rule in sync with the justfile's _banner recipe.
  local rule='────────────────────────────────────────────────'
  if [[ "$use_color" -eq 1 ]]; then
    printf '\n%s  \033[1;%sm%s\033[0m\n\033[%sm%s\033[0m\n' \
      "$icon" "$color" "$title" "$color" "$rule"
  else
    printf '\n%s  %s\n%s\n' "$icon" "$title" "$rule"
  fi
  note_rows 3
}

command_line() {
  if [[ "$use_color" -eq 1 ]]; then
    printf '  \033[2m$ %s\033[0m\n' "$1"
  else
    printf '  $ %s\n' "$1"
  fi
  note_line "  \$ $1"
}

# delay keeps osascript alive long enough for Notification Center to accept the banner.
# || true: a missing permission or a failed osascript must not change the restart or exit.
notify_mac() {
  local title="$1" body="$2"
  command_line "osascript display notification \"$body\" with title \"$title\" subtitle \"bob install-all\" sound name \"default\""
  osascript - "$title" "$body" <<'APPLESCRIPT' || true
on run argv
  display notification (item 2 of argv) with title (item 1 of argv) subtitle "bob install-all" sound name "default"
  delay 0.5
end run
APPLESCRIPT
}

glyph_line() {
  local color="$1"
  local prefix="$2"
  local glyph="$3"
  local detail="$4"
  printf '%s' "$prefix"
  paint "$color" "$glyph"
  printf ' %s\n' "$detail"
  note_line "${prefix}${glyph} ${detail}"
}

dim_diagnostics() {
  local output="$1" line
  [[ -n "$output" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$use_color" -eq 1 ]]; then
      printf '  \033[2m    %s\033[0m\n' "$line"
    else
      printf '      %s\n' "$line"
    fi
    note_line "      $line"
  done <<<"$output"
}

format_duration() {
  local seconds="$1"
  if (( seconds < 60 )); then
    printf '%ss' "$seconds"
  else
    printf '%dm %02ds' "$((seconds / 60))" "$((seconds % 60))"
  fi
}

format_clock() {
  local seconds="$1"
  printf '%d:%02d' "$((seconds / 60))" "$((seconds % 60))"
}

record_step_start() {
  active_step="$1"
  active_phase="$2"
  active_step_start="$SECONDS"
}

record_step_finish() {
  local outcome="$1" duration
  [[ -n "$active_step" ]] || return 0
  duration="$((SECONDS - active_step_start))"
  install_ui record --step "$active_step" --phase "$active_phase" \
    --secs "$duration" --outcome "$outcome" >/dev/null 2>&1 || true
  active_step=""
  active_phase=""
}

interrupt_run() {
  trap - INT
  if [[ -t 1 ]]; then
    printf '\r\033[K'
  fi
  printf '  ✗ interrupted after %s\n' "$(format_clock "$SECONDS")"
  record_step_finish interrupted
  exit 130
}

trap 'interrupt_run' INT

add_summary() {
  local name="$1"
  local status="$2"
  local detail="$3"
  local duration="$4"
  local glyph color
  case "$status" in
    ok) glyph='✓'; color=32 ;;
    warn) glyph='⚠'; color=33 ;;
    fail) glyph='✗'; color=31 ;;
    restart) glyph='↻'; color=36 ;;
    *) glyph='–'; color=2 ;;
  esac
  summary_names[${#summary_names[@]}]="$name"
  summary_glyphs[${#summary_glyphs[@]}]="$glyph"
  summary_details[${#summary_details[@]}]="$detail"
  summary_durations[${#summary_durations[@]}]="$duration"
  summary_colors[${#summary_colors[@]}]="$color"
}

print_summary() {
  local i
  for i in "${!summary_names[@]}"; do
    printf '  '
    paint "${summary_colors[$i]}" "${summary_glyphs[$i]}"
    printf '  %-16s %s' "${summary_names[$i]}" "${summary_details[$i]}"
    if [[ -n "${summary_durations[$i]}" ]]; then
      printf '  %s' "${summary_durations[$i]}"
    fi
    printf '\n'
  done
}

pull_repo() {
  local dir="$1"
  local old_sha new_sha count pull_status pre_full post_full
  PULL_OUTPUT=""
  PULL_PRE=""
  PULL_POST=""
  if ! git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    PULL_STATE=none
    PULL_DETAIL='not a git checkout'
    return 0
  fi
  if ! pre_full="$(git -C "$dir" rev-parse --verify HEAD 2>/dev/null)"; then
    PULL_STATE=none
    PULL_DETAIL='not a git checkout'
    return 0
  fi
  if ! old_sha="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"; then
    old_sha="${pre_full:0:7}"
  fi
  PULL_PRE="$pre_full"
  pull_tmp_file="$(mktemp "${TMPDIR:-/tmp}/bob-install-all.XXXXXX")"
  if git -C "$dir" pull --ff-only --no-rebase >"$pull_tmp_file" 2>&1; then
    pull_status=0
  else
    pull_status=$?
  fi
  if (( pull_status != 0 )); then
    PULL_STATE=warn
    PULL_DETAIL='pull failed — using local checkout'
    PULL_OUTPUT="$(cat "$pull_tmp_file")"
    PULL_POST="$pre_full"
  else
    post_full="$(git -C "$dir" rev-parse --verify HEAD 2>/dev/null || printf '%s' "$pre_full")"
    PULL_POST="$post_full"
    new_sha="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || printf '%s' "$old_sha")"
    if [[ "$pre_full" != "$post_full" ]]; then
      count="$(git -C "$dir" rev-list --count "$pre_full..$post_full" 2>/dev/null || printf '0')"
      PULL_STATE=updated
      if [[ "$count" == 1 ]]; then
        PULL_DETAIL="1 new commit · $old_sha → $new_sha"
      else
        PULL_DETAIL="$count new commits · $old_sha → $new_sha"
      fi
    else
      PULL_STATE=current
      PULL_DETAIL="up to date · $new_sha"
    fi
  fi
  rm -f "$pull_tmp_file"
  pull_tmp_file=""
}

show_pull_row() {
  local name="$1" padded
  padded="$(printf '%-16s' "$name")"
  case "$PULL_STATE" in
    cloned|updated|current)
      printf '  ⇣  %s ' "$padded"
      paint 32 '✓'
      printf '  %s\n' "$PULL_DETAIL"
      ;;
    warn)
      printf '  ⇣  %s ' "$padded"
      paint 33 '⚠'
      printf '  %s\n' "$PULL_DETAIL"
      dim_diagnostics "$PULL_OUTPUT"
      ;;
    *)
      printf '  ⇣  %s ' "$padded"
      paint 2 '–'
      printf '  %s\n' "$PULL_DETAIL"
      ;;
  esac
}

dim_row() {
  if [[ "$use_color" -eq 1 ]]; then
    printf '  \033[2m%s\033[0m\n' "$1"
  else
    printf '  %s\n' "$1"
  fi
  note_line "  $1"
}

# Today's pre-pull checks, shared by the header pulls and the steps.
plugins_eligible() {
  [[ -d "$plugins_dir" && -d "$plugins_dir/plugins" && -d "$obsidian_dir" ]]
}

mac_capture_eligible() {
  [[ "$(uname -s)" == Darwin && -d "$mac_capture_dir" && -f "$mac_capture_dir/Scripts/install.sh" ]]
}

is_work_tree() {
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

# Asks [y/N] and clones on yes. Sets CLONE_STATE to cloned, failed, or "".
offer_clone() {
  local name="$1" dir="$2" url answer sha
  url="$clone_base/$name.git"
  CLONE_STATE=''
  if (( CLONE_SECTION_SHOWN == 0 )); then
    banner 33 '📥' 'MISSING CHECKOUTS'
    CLONE_SECTION_SHOWN=1
  fi
  printf '  %s is missing at %s\n' "$name" "$(display_path "$dir")"
  printf '  Clone it from %s? [y/N] ' "$url"
  if ! read -r answer; then
    answer=''
    printf '\n'
  fi
  case "$answer" in
    y|Y|yes|Yes|YES) ;;
    *)
      glyph_line 2 '  ' '–' "not cloned · skipping $name"
      return 0
      ;;
  esac
  # Streams raw so SSH host-key and passphrase prompts reach the terminal.
  command_line "git clone $url $(display_path "$dir")"
  if git clone "$url" "$dir"; then
    sha="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
    glyph_line 32 '  ' '✓' "cloned · $sha"
    CLONE_STATE=cloned
  else
    glyph_line 31 '  ' '✗' 'clone failed'
    CLONE_STATE=failed
  fi
}

# Offers only siblings this run would install, and only when a person can answer.
offer_missing_clones() {
  CLONE_SECTION_SHOWN=0
  [[ -t 0 && -t 1 ]] || return 0
  if [[ ! -e "$plugins_dir" && -d "$obsidian_dir" ]]; then
    offer_clone bob-plugins "$plugins_dir"
    plugins_clone_state="$CLONE_STATE"
  fi
  if [[ "$(uname -s)" == Darwin && ! -e "$mac_capture_dir" ]]; then
    offer_clone bob-mac-capture "$mac_capture_dir"
    mac_capture_clone_state="$CLONE_STATE"
  fi
}

fresh_clone_result() {
  PULL_OUTPUT=''
  PULL_STATE=cloned
  PULL_PRE=''
  PULL_POST="$(git -C "$1" rev-parse --verify HEAD 2>/dev/null || printf '')"
  PULL_DETAIL="cloned · $(git -C "$1" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
}

# Resolve the legacy upgrade range: the previous script re-exec'd this one
# with only BOB_INSTALL_ALL_SELF_PULL_DETAIL ("N new commit(s) · old → new").
# Both short SHAs must resolve and the old one must be an ancestor; otherwise
# the digest gets no invented range.
resolve_legacy_pull_detail() {
  local detail="$1" pair old_short new_short old_full new_full
  legacy_digest_unavailable=0
  cli_pull_pre=""; cli_pull_post=""
  pair="${detail##*· }"
  old_short="${pair%% → *}"
  new_short="${pair##*→ }"
  if [[ -z "$old_short" || -z "$new_short" || "$old_short" == "$pair" || "$new_short" == "$pair" ]]; then
    legacy_digest_unavailable=1
    return 0
  fi
  if ! old_full="$(git -C "$root" rev-parse --verify "${old_short}^{commit}" 2>/dev/null)"; then
    legacy_digest_unavailable=1
    return 0
  fi
  if ! new_full="$(git -C "$root" rev-parse --verify "${new_short}^{commit}" 2>/dev/null)"; then
    legacy_digest_unavailable=1
    return 0
  fi
  if ! git -C "$root" merge-base --is-ancestor "$old_full" "$new_full" 2>/dev/null; then
    legacy_digest_unavailable=1
    return 0
  fi
  cli_pull_pre="$old_full"
  cli_pull_post="$new_full"
}

extract_json_integer() {
  local key="$1"
  local json="$2"
  printf '%s\n' "$json" | sed -n \
    "s/.*\"$key\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" | head -n 1
}

mark_restart_pending() {
  mkdir -p "$(dirname "$restart_marker")" || true
  : >"$restart_marker" || true
}

clear_restart_pending() {
  rm -f "$restart_marker"
}

plugin_sync_rows() {
  local preview="$1" line
  while IFS= read -r line || [[ -n "$line" ]]; do
    printf '%s\n' "$line"
    note_line "$line"
  done < <(printf '%s\n' "$preview" | "${BOB_INSTALL_UI_PYTHON}" -c '
import json, sys
try:
    result = json.load(sys.stdin)
except (ValueError, TypeError):
    raise SystemExit(1)
for plugin in result.get("plugins", []):
    copied = [file.get("name", "") for file in plugin.get("files", [])
              if file.get("action") in ("created", "updated", "forced")]
    copied = [name for name in copied if name]
    if copied:
        print("↻ {}  {}".format(plugin.get("id", "plugin"), ", ".join(copied)))
' 2>/dev/null)
}

print_plugin_sync_warnings() {
  local log_path="$1" line warning_detail=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      '  ⚠ '*|'  ✗ '*)
        printf '%s\n' "$line"
        note_line "$line"
        warning_detail=1
        ;;
      '             ⚠ '*|'             ✗ '*|'             ↳ '*)
        if (( warning_detail )); then
          printf '%s\n' "$line"
          note_line "$line"
        fi
        ;;
      *) warning_detail=0 ;;
    esac
  done <"$log_path"
}

print_plugin_sync_excerpt() {
  local excerpt="$1" line
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      '             +'*|'             -'*|'             @@'*|'              '*)
        continue
        ;;
      '             ... and '*|'             binary or minified file differs'*)
        continue
        ;;
    esac
    dim_diagnostics "$line"
  done <<<"$excerpt"
}

print_plugin_sync_failure() {
  local log_path="$1" first_line excerpt
  first_line="$(grep -n -m 1 -i 'error' "$log_path" 2>/dev/null | cut -d: -f1 || true)"
  if [[ "$first_line" =~ ^[0-9]+$ ]]; then
    excerpt="$(sed -n "${first_line},$((first_line + 39))p" "$log_path")"
  else
    excerpt="$(tail -n 20 "$log_path" 2>/dev/null || true)"
  fi
  dim_row 'plugin sync log excerpt:'
  print_plugin_sync_excerpt "$excerpt"
  dim_row "full log  $(display_path "$log_path")"
}

plugin_step() {
  local step_start pull_detail step_warning=0
  local bob_bin output count synced drift plugin_detail
  local preview pending copied_clause plugin_log_dir plugin_log live_sync=0 sync_status
  banner 34 '🧩' 'BOB-PLUGINS  2/3'
  step_start="$SECONDS"
  if [[ ! -d "$plugins_dir" ]]; then
    if [[ "$plugins_clone_state" == failed ]]; then
      plugin_detail="clone failed · retry: git clone $clone_base/bob-plugins.git $(display_path "$plugins_dir")"
      glyph_line 31 '  ' '✗' "$plugin_detail"
      FAILURES=$((FAILURES + 1))
      add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
      return 0
    fi
    plugin_detail="skipped · missing checkout · git clone $clone_base/bob-plugins.git $(display_path "$plugins_dir")"
    glyph_line 2 '  ' '–' "$plugin_detail"
    add_summary 'bob-plugins' skip "$plugin_detail" ''
    return 0
  fi
  if [[ ! -d "$plugins_dir/plugins" ]]; then
    plugin_detail="doesn't look like bob-plugins"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  if [[ ! -d "$obsidian_dir" ]]; then
    plugin_detail="skipped · no Obsidian vault at $(display_path "$obsidian_dir")"
    glyph_line 2 '  ' '–' "$plugin_detail"
    add_summary 'bob-plugins' skip "$plugin_detail" ''
    return 0
  fi

  # The header already pulled; consume the recorded result, never pull again.
  pull_detail="$plugins_pull_detail"
  if [[ "$plugins_pull_state" == warn ]]; then
    step_warning=$((step_warning + 1))
  fi
  if [[ -x "${CARGO_INSTALL_ROOT:-${CARGO_HOME:-$HOME/.cargo}}/bin/bob" ]]; then
    bob_bin="${CARGO_INSTALL_ROOT:-${CARGO_HOME:-$HOME/.cargo}}/bin/bob"
  else
    bob_bin="$(command -v bob || true)"
  fi
  if [[ -z "$bob_bin" ]]; then
    plugin_detail="$pull_detail · bob binary not found in the install root or on PATH"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  command_line "bob plugins sync --dry-run --format json --no-pull --repo $(display_path "$plugins_dir")"
  if ! preview="$("$bob_bin" plugins sync --dry-run --format json --no-pull --repo "$plugins_dir")"; then
    plugin_detail="$pull_detail · could not preview plugin sync"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  pending="$(extract_json_integer copied "$preview")"
  if [[ -z "$pending" ]]; then
    plugin_detail="$pull_detail · could not read plugin sync preview"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  if (( pending > 0 )); then
    PLUGINS_CHANGED=1
    mark_restart_pending
  fi
  if (( pending == 1 )); then
    copied_clause=' · 1 file copied'
  elif (( pending > 1 )); then
    copied_clause=" · $pending files copied"
  else
    copied_clause=''
  fi
  command_line "bob plugins sync --no-pull --repo $(display_path "$plugins_dir")"
  if install_ui_live_eligible; then
    plugin_log_dir="${BOB_INSTALL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/bob-cli/install-all}/logs"
    plugin_log="$plugin_log_dir/$run_id-bob-plugins.log"
    if (umask 077 && mkdir -p "$plugin_log_dir" && : >"$plugin_log"); then
      chmod 600 "$plugin_log" 2>/dev/null || true
      live_sync=1
    fi
  fi
  if (( live_sync )); then
    record_step_start bob-plugins sync
    if "$bob_bin" plugins sync --no-pull --repo "$plugins_dir" >"$plugin_log" 2>&1; then
      sync_status=0
    else
      sync_status=$?
    fi
    if (( sync_status == 0 )); then
      record_step_finish ok
      plugin_sync_rows "$preview" || true
      print_plugin_sync_warnings "$plugin_log"
    else
      record_step_finish fail
      plugin_detail="$pull_detail · sync failed"
      print_plugin_sync_warnings "$plugin_log"
      print_plugin_sync_failure "$plugin_log"
      glyph_line 31 '  ' '✗' "$plugin_detail"
      FAILURES=$((FAILURES + 1))
      add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
      return 0
    fi
  else
    record_step_start bob-plugins sync
    if "$bob_bin" plugins sync --no-pull --repo "$plugins_dir"; then
      output=''
      record_step_finish ok
    else
      sync_status=$?
      record_step_finish fail
      plugin_detail="$pull_detail · sync failed"
      glyph_line 31 '  ' '✗' "$plugin_detail"
      FAILURES=$((FAILURES + 1))
      add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
      return 0
    fi
  fi
  command_line "bob plugins list --no-pull --repo $(display_path "$plugins_dir") --format json"
  if ! output="$("$bob_bin" plugins list --no-pull --repo "$plugins_dir" --format json)"; then
    plugin_detail="$pull_detail · could not verify plugin sync"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  count="$(extract_json_integer count "$output")"
  synced="$(extract_json_integer synced "$output")"
  drift="$(extract_json_integer drift "$output")"
  if [[ -z "$count" || -z "$synced" || -z "$drift" ]]; then
    plugin_detail="$pull_detail · could not read plugin sync counts"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  if (( drift == 0 )); then
    plugin_detail="$pull_detail$copied_clause · $synced/$count plugins in sync"
    install_ui_mark_installed bob-plugins "$plugins_dir"
    if (( step_warning > 0 )); then
      glyph_line 33 '  ' '⚠' "$plugin_detail"
      add_summary 'bob-plugins' warn "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
      WARNINGS=$((WARNINGS + step_warning))
    else
      glyph_line 32 '  ' '✓' "$plugin_detail"
      add_summary 'bob-plugins' ok "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    fi
  else
    step_warning=$((step_warning + 1))
    plugin_detail="$pull_detail$copied_clause · $synced/$count plugins in sync; $drift drifted (dirty in vault — review, then bob plugins sync -F)"
    glyph_line 33 '  ' '⚠' "$plugin_detail"
    add_summary 'bob-plugins' warn "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    WARNINGS=$((WARNINGS + step_warning))
  fi
}

mac_capture_step() {
  local step_start pull_detail step_warning=0 status detail install_status
  local signing_output signing_status identity
  banner 32 '🍎' 'BOB-MAC-CAPTURE  3/3'
  step_start="$SECONDS"
  if [[ "$(uname -s)" != Darwin ]]; then
    detail='skipped · macOS only'
    glyph_line 2 '  ' '–' "$detail"
    add_summary 'bob-mac-capture' skip "$detail" ''
    return 0
  fi
  if [[ ! -d "$mac_capture_dir" ]]; then
    if [[ "$mac_capture_clone_state" == failed ]]; then
      detail="clone failed · retry: git clone $clone_base/bob-mac-capture.git $(display_path "$mac_capture_dir")"
      glyph_line 31 '  ' '✗' "$detail"
      FAILURES=$((FAILURES + 1))
      add_summary 'bob-mac-capture' fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
      return 0
    fi
    detail="skipped · missing checkout · git clone $clone_base/bob-mac-capture.git $(display_path "$mac_capture_dir")"
    glyph_line 2 '  ' '–' "$detail"
    add_summary 'bob-mac-capture' skip "$detail" ''
    return 0
  fi
  if [[ ! -f "$mac_capture_dir/Scripts/install.sh" ]]; then
    detail="doesn't look like bob-mac-capture (missing Scripts/install.sh)"
    glyph_line 31 '  ' '✗' "$detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-mac-capture' fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  # The header already pulled; consume the recorded result, never pull again.
  pull_detail="$maccap_pull_detail"
  if [[ "$maccap_pull_state" == warn ]]; then
    step_warning=$((step_warning + 1))
  fi

  if [[ -t 0 && -t 1 ]] && \
      just --justfile "$mac_capture_dir/justfile" --show signing-check >/dev/null 2>&1; then
    command_line "just --justfile $(display_path "$mac_capture_dir/justfile") signing-check"
    if signing_output="$(cd "$mac_capture_dir" && just --justfile "$mac_capture_dir/justfile" signing-check)"; then
      identity="${signing_output%%$'\n'*}"
      dim_row "signing  ${identity:--}"
    else
      signing_status=$?
      case "$signing_status" in
        77)
          status=fail
          detail="$pull_detail · signing identity locked in this session · run security unlock-keychain or install from a GUI Terminal"
          ;;
        78)
          status=fail
          detail="$pull_detail · login keychain password differs from the Mac login password · run security set-keychain-password ~/Library/Keychains/login.keychain-db"
          ;;
        *)
          status=fail
          detail="$pull_detail · signing check failed (exit $signing_status)"
          ;;
      esac
      glyph_line 31 '  ' '✗' "$detail"
      FAILURES=$((FAILURES + 1))
      add_summary 'bob-mac-capture' fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
      return 0
    fi
  fi

  command_line "just --justfile $(display_path "$mac_capture_dir/justfile") install $(display_path "$HOME/Applications")"
  if (cd "$mac_capture_dir" && install_ui_run bob-mac-capture swiftpm "$mac_capture_dir" \
      "built and signed" --success-code 72 -- just --justfile "$mac_capture_dir/justfile" \
      install "$HOME/Applications"); then
    add_runner_rows bob-mac-capture
    status=ok
    install_ui_mark_installed bob-mac-capture "$mac_capture_dir"
    detail="$pull_detail · installed $(display_path "$HOME/Applications/Bob Mac Capture.app")"
  else
    install_status=$?
    add_runner_rows bob-mac-capture
    if (( install_status == 130 )); then
      interrupt_run
    fi
    if (( install_status == 72 )); then
      status=warn
      step_warning=$((step_warning + 1))
      install_ui_mark_installed bob-mac-capture "$mac_capture_dir"
      detail="$pull_detail · installed; restart it via the Bob Mac Capture menu-bar icon → Restart Bob Mac Capture"
    elif (( install_status == 78 )); then
      status=fail
      detail="$pull_detail · login keychain password differs from the Mac login password · run security set-keychain-password ~/Library/Keychains/login.keychain-db"
    elif (( install_status == 77 )); then
      status=fail
      detail="$pull_detail · signing identity locked in this session · run security unlock-keychain or install from a GUI Terminal"
    else
      status=fail
      detail="$pull_detail · install failed (exit $install_status)"
    fi
  fi
  if [[ "$status" == ok || "$status" == warn ]] && [[ -z "${CODESIGN_IDENTITY:-}" ]] && mac_capture_is_adhoc "$HOME/Applications/Bob Mac Capture.app"; then
    step_warning=$((step_warning + 1))
    detail="$detail · installed ad-hoc · Accessibility grant resets each install · rerun from a GUI Terminal or unlock the login keychain to sign with the stable identity"
  fi
  case "$status" in
    ok)
      if (( step_warning > 0 )); then
        glyph_line 33 '  ' '⚠' "$detail"
        add_summary 'bob-mac-capture' warn "$detail" "$(format_duration "$((SECONDS - step_start))")"
        WARNINGS=$((WARNINGS + step_warning))
      else
        glyph_line 32 '  ' '✓' "$detail"
        add_summary 'bob-mac-capture' ok "$detail" "$(format_duration "$((SECONDS - step_start))")"
      fi
      ;;
    warn)
      glyph_line 33 '  ' '⚠' "$detail"
      add_summary 'bob-mac-capture' warn "$detail" "$(format_duration "$((SECONDS - step_start))")"
      WARNINGS=$((WARNINGS + step_warning))
      ;;
    *)
      glyph_line 31 '  ' '✗' "$detail"
      FAILURES=$((FAILURES + 1))
      add_summary 'bob-mac-capture' fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
      ;;
  esac
}

mac_capture_is_adhoc() {
  local app_path="$1" codesign_output
  [[ -x /usr/bin/codesign && -d "$app_path" ]] || return 1
  codesign_output="$(/usr/bin/codesign -dv "$app_path" 2>&1 || true)"
  [[ "$codesign_output" == *'Signature=adhoc'* ]]
}

obsidian_step() {
  local step_start detail running i cli reason pending_suffix
  banner 36 '🔄' 'OBSIDIAN'
  step_start="$SECONDS"
  if (( PLUGINS_CHANGED == 1 )); then
    reason='plugins changed'
  elif [[ -f "$restart_marker" ]]; then
    reason='restart pending from an earlier run'
  else
    detail='plugins unchanged · restart not needed'
    glyph_line 2 '  ' '–' "$detail"
    add_summary obsidian skip "$detail" ''
    return 0
  fi
  if (( PLUGINS_CHANGED == 0 )); then
    pending_suffix=' · pending from an earlier run'
  else
    pending_suffix=''
  fi
  if (( FAILURES > 0 )); then
    if [[ "$(uname -s)" == Darwin ]]; then
      if (( PLUGINS_CHANGED == 1 )); then
        notify_mac 'Obsidian needs a restart' \
          'Plugins changed, but a step failed. Fix it and rerun just install-all.'
      else
        notify_mac 'Obsidian needs a restart' \
          'An earlier plugin update still needs a restart, but a step failed. Fix it and rerun just install-all.'
      fi
    fi
    detail="$reason; not restarted: a step failed — fix it and rerun just install-all"
    glyph_line 2 '  ' '–' "$detail"
    add_summary obsidian skip "$detail" ''
    return 0
  fi
  case "$(uname -s)" in
    Darwin)
      if ! running="$(osascript -e 'application id "md.obsidian" is running' 2>/dev/null)"; then
        detail='could not check whether Obsidian is running'
        glyph_line 31 '  ' '✗' "$detail"
        FAILURES=$((FAILURES + 1))
        add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
        return 0
      fi
      if [[ "$running" != true ]]; then
        detail='not running · plugins load on next launch'
        glyph_line 2 '  ' '–' "$detail"
        add_summary obsidian skip "$detail" ''
        clear_restart_pending
        return 0
      fi
      if (( PLUGINS_CHANGED == 1 )); then
        notify_mac 'Restarting Obsidian' \
          'Plugins changed. It will reopen in a moment.'
      else
        notify_mac 'Restarting Obsidian' \
          'Finishing an earlier plugin update. It will reopen in a moment.'
      fi
      record_step_start obsidian restart
      command_line "osascript -e 'tell application id \"md.obsidian\" to quit'"
      if ! osascript -e 'tell application id "md.obsidian" to quit'; then
        record_step_finish fail
        notify_mac 'Obsidian needs a restart' \
          'Quit failed. Allow Terminal in Automation, then rerun just install-all.'
        detail='quit failed · allow Terminal in System Settings → Privacy & Security → Automation'
        glyph_line 31 '  ' '✗' "$detail"
        FAILURES=$((FAILURES + 1))
        add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
        return 0
      fi
      i=0
      while (( i < 60 )); do
        if ! running="$(osascript -e 'application id "md.obsidian" is running' 2>/dev/null)"; then
          record_step_finish fail
          detail='could not check whether Obsidian quit'
          glyph_line 31 '  ' '✗' "$detail"
          FAILURES=$((FAILURES + 1))
          add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
          return 0
        fi
        if [[ "$running" != true ]] && ! pgrep -x Obsidian >/dev/null 2>&1; then
          break
        fi
        sleep 0.5
        i=$((i + 1))
      done
      if (( i >= 60 )); then
        record_step_finish fail
        notify_mac 'Obsidian needs a restart' \
          'Obsidian did not quit. Close any open dialog, then restart it to load the new plugins.'
        detail='Obsidian did not quit within 30s (an open dialog?) — not relaunching'
        glyph_line 31 '  ' '✗' "$detail"
        FAILURES=$((FAILURES + 1))
        add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
        return 0
      fi
      command_line 'open -b md.obsidian'
      if ! open -b md.obsidian; then
        record_step_finish fail
        notify_mac 'Obsidian needs a restart' \
          'Obsidian quit but did not reopen. Open it to load the new plugins.'
        detail='relaunch failed'
        glyph_line 31 '  ' '✗' "$detail"
        FAILURES=$((FAILURES + 1))
        add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
        return 0
      fi
      i=0
      while (( i < 30 )); do
        if running="$(osascript -e 'application id "md.obsidian" is running' 2>/dev/null)" && [[ "$running" == true ]]; then
          record_step_finish ok
          detail="restarted${pending_suffix}"
          glyph_line 36 '  ' '↻' "$detail"
          add_summary obsidian restart "$detail" "$(format_duration "$((SECONDS - step_start))")"
          clear_restart_pending
          return 0
        fi
        sleep 0.5
        i=$((i + 1))
      done
      record_step_finish ok
      detail='relaunch requested; not confirmed yet'
      glyph_line 33 '  ' '⚠' "$detail"
      WARNINGS=$((WARNINGS + 1))
      add_summary obsidian warn "$detail" "$(format_duration "$((SECONDS - step_start))")"
      clear_restart_pending
      ;;
    Linux)
      if ! pgrep -x obsidian >/dev/null 2>&1; then
        detail='not running · plugins load on next launch'
        glyph_line 2 '  ' '–' "$detail"
        add_summary obsidian skip "$detail" ''
        clear_restart_pending
        return 0
      fi
      cli="$HOME/.local/bin/obsidian"
      if [[ ! -x "$cli" ]]; then
        detail='running; restart it manually to load the new plugins'
        glyph_line 33 '  ' '⚠' "$detail"
        WARNINGS=$((WARNINGS + 1))
        add_summary obsidian warn "$detail" "$(format_duration "$((SECONDS - step_start))")"
        clear_restart_pending
        return 0
      fi
      command_line "$(display_path "$cli") restart"
      record_step_start obsidian restart
      if "$cli" restart; then
        record_step_finish ok
        detail="restart requested${pending_suffix}"
        glyph_line 36 '  ' '↻' "$detail"
        add_summary obsidian restart "$detail" "$(format_duration "$((SECONDS - step_start))")"
        clear_restart_pending
      else
        record_step_finish fail
        detail='Obsidian CLI restart failed'
        glyph_line 31 '  ' '✗' "$detail"
        FAILURES=$((FAILURES + 1))
        add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
      fi
      ;;
    *)
      detail="unsupported OS: $(uname -s)"
      glyph_line 31 '  ' '✗' "$detail"
      FAILURES=$((FAILURES + 1))
      add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
      ;;
  esac
}

prune_run_dirs() {
  local dir="$1" nlist total
  [[ -d "$dir" ]] || return 0
  nlist="$(ls -t "$dir" 2>/dev/null)" || return 0
  [[ -n "$nlist" ]] || return 0
  total="$(printf '%s\n' "$nlist" | wc -l | tr -d ' ')"
  if [[ "$total" =~ ^[0-9]+$ ]] && (( total > 10 )); then
    printf '%s\n' "$nlist" | tail -n +11 | while IFS= read -r old; do
      [[ -n "$old" ]] || continue
      rm -rf "$dir/$old"
    done
  fi
}

print_digest() {
  local digest_out bob_bin nrepos
  local -a dargs
  if [[ "${BOB_INSTALL_UI:-}" == "0" ]]; then
    return 0
  fi
  if (( legacy_digest_unavailable )); then
    dim_row 'changes unavailable for this upgrade'
  fi
  if ! mkdir -p "$ui_run_dir" 2>/dev/null; then
    ui_run_dir=""
  fi
  prune_run_dirs "$ui_state_dir/runs"
  dargs=()
  nrepos=0
  dargs[${#dargs[@]}]='--repo'
  dargs[${#dargs[@]}]="bob-cli=$root"
  dargs[${#dargs[@]}]='--pull'
  dargs[${#dargs[@]}]="bob-cli=${cli_pull_state:-none}"
  dargs[${#dargs[@]}]='--color'
  dargs[${#dargs[@]}]='bob-cli=35'
  if [[ -n "$cli_pull_pre" ]]; then
    dargs[${#dargs[@]}]='--pre'
    dargs[${#dargs[@]}]="bob-cli=$cli_pull_pre"
  fi
  if [[ -n "$cli_pull_post" ]]; then
    dargs[${#dargs[@]}]='--post'
    dargs[${#dargs[@]}]="bob-cli=$cli_pull_post"
  fi
  nrepos=$((nrepos + 1))
  if is_work_tree "$plugins_dir"; then
    dargs[${#dargs[@]}]='--repo'
    dargs[${#dargs[@]}]="bob-plugins=$plugins_dir"
    dargs[${#dargs[@]}]='--pull'
    dargs[${#dargs[@]}]="bob-plugins=${plugins_pull_state:-none}"
    dargs[${#dargs[@]}]='--color'
    dargs[${#dargs[@]}]='bob-plugins=34'
    if [[ -n "$plugins_pull_pre" ]]; then
      dargs[${#dargs[@]}]='--pre'
      dargs[${#dargs[@]}]="bob-plugins=$plugins_pull_pre"
    fi
    if [[ -n "$plugins_pull_post" ]]; then
      dargs[${#dargs[@]}]='--post'
      dargs[${#dargs[@]}]="bob-plugins=$plugins_pull_post"
    fi
    nrepos=$((nrepos + 1))
  fi
  if is_work_tree "$mac_capture_dir"; then
    dargs[${#dargs[@]}]='--repo'
    dargs[${#dargs[@]}]="bob-mac-capture=$mac_capture_dir"
    dargs[${#dargs[@]}]='--pull'
    dargs[${#dargs[@]}]="bob-mac-capture=${maccap_pull_state:-none}"
    dargs[${#dargs[@]}]='--color'
    dargs[${#dargs[@]}]='bob-mac-capture=32'
    if [[ -n "$maccap_pull_pre" ]]; then
      dargs[${#dargs[@]}]='--pre'
      dargs[${#dargs[@]}]="bob-mac-capture=$maccap_pull_pre"
    fi
    if [[ -n "$maccap_pull_post" ]]; then
      dargs[${#dargs[@]}]='--post'
      dargs[${#dargs[@]}]="bob-mac-capture=$maccap_pull_post"
    fi
    nrepos=$((nrepos + 1))
  fi
  dargs[${#dargs[@]}]='--steps'
  dargs[${#dargs[@]}]="$nrepos"
  dargs[${#dargs[@]}]='--plugins'
  dargs[${#dargs[@]}]='bob-plugins'
  if [[ -x "${CARGO_INSTALL_ROOT:-${CARGO_HOME:-$HOME/.cargo}}/bin/bob" ]]; then
    bob_bin="${CARGO_INSTALL_ROOT:-${CARGO_HOME:-$HOME/.cargo}}/bin/bob"
  else
    bob_bin="$(command -v bob || true)"
  fi
  if [[ -n "$bob_bin" ]]; then
    dargs[${#dargs[@]}]='--bob-bin'
    dargs[${#dargs[@]}]="$bob_bin"
  fi
  if [[ -n "$ui_run_dir" ]]; then
    dargs[${#dargs[@]}]='--record'
    dargs[${#dargs[@]}]="$ui_run_dir/digest.json"
  fi
  if digest_out="$(install_ui digest ${dargs[@]+"${dargs[@]}"} 2>/dev/null)"; then
    if [[ -n "$digest_out" ]]; then
      printf '%s\n' "$digest_out"
    fi
  else
    dim_row "what's new unavailable"
  fi
}

print_plan() {
  local plan_out profile
  local -a pargs
  if [[ "${BOB_INSTALL_UI:-}" == "0" ]]; then
    return 0
  fi
  [[ -t 1 && "${TERM:-}" != dumb ]] || return 0
  mkdir -p "$ui_run_dir" 2>/dev/null || true
  profile="${BOB_INSTALL_PROFILE:-local-install}"
  pargs=(--step "bob-cli=$root" --profile "bob-cli=$profile" --parser bob-cli=cargo)
  pargs[${#pargs[@]}]='--aux'
  pargs[${#pargs[@]}]='bob-plugins'
  pargs[${#pargs[@]}]='--aux'
  pargs[${#pargs[@]}]='obsidian'
  if mac_capture_eligible; then
    pargs[${#pargs[@]}]='--step'
    pargs[${#pargs[@]}]="bob-mac-capture=$mac_capture_dir"
    pargs[${#pargs[@]}]='--parser'
    pargs[${#pargs[@]}]='bob-mac-capture=swiftpm'
  fi
  if [[ -n "$ui_run_dir" ]]; then
    pargs[${#pargs[@]}]='--record'
    pargs[${#pargs[@]}]="$ui_run_dir/plan.json"
  fi
  if plan_out="$(install_ui plan ${pargs[@]+"${pargs[@]}"} 2>/dev/null)"; then
    if [[ -n "$plan_out" ]]; then
      printf '%s\n' "$plan_out"
      note_line "$plan_out"
    fi
  fi
}

print_replay() {
  local replay_out summary_rows
  if [[ "${BOB_INSTALL_UI:-}" == "0" ]]; then
    return 0
  fi
  [[ -f "$ui_run_dir/digest.json" ]] || return 0
  summary_rows=$((5 + ${#summary_names[@]}))
  if replay_out="$(install_ui replay --record "$ui_run_dir/digest.json" \
      --rows-after "$rows_after" --summary-rows "$summary_rows" 2>/dev/null)"; then
    if [[ -n "$replay_out" ]]; then
      printf '%s\n' "$replay_out"
    fi
  fi
}

# Quiet completion banner: unlike notify_mac it never echoes the osascript
# command, because it is a pure notification below the summary.
completion_banner() {
  local title="$1"
  [[ "$(uname -s)" == Darwin ]] || return 0
  command -v osascript >/dev/null 2>&1 || return 0
  osascript - "$title" <<'APPLESCRIPT' || true
on run argv
  display notification "" with title (item 1 of argv) subtitle "bob install-all" sound name "default"
  delay 0.5
end run
APPLESCRIPT
}

completion_cues() {
  local final_text="$1" elapsed="$2"
  local bell_after="${BOB_INSTALL_BELL_AFTER:-60}"
  local banner_after="${BOB_INSTALL_NOTIFY_AFTER:-120}"
  if [[ "${BOB_INSTALL_NOTIFY:-}" == "0" ]]; then
    return 0
  fi
  case "$bell_after" in ''|*[!0-9]*) bell_after=60 ;; esac
  case "$banner_after" in ''|*[!0-9]*) banner_after=120 ;; esac
  if [[ -t 1 ]] && (( elapsed >= bell_after )); then
    printf '\a'
  fi
  if (( elapsed >= banner_after )); then
    completion_banner "$final_text"
  fi
}

if [[ "$header_done" != 1 ]]; then
  banner 36 '🚀' 'INSTALL ALL'
  printf '  from     %s\n' "$(display_path "$parent")"
  printf '  then     restart Obsidian if the plugin sync changes the vault\n'
  offer_missing_clones
elif [[ "$clones_offered" != 1 ]]; then
  # Re-exec'd by an installer that predates the clone offer.
  offer_missing_clones
fi

if [[ -n "$self_pull_state" ]]; then
  PULL_STATE="$self_pull_state"
  PULL_DETAIL="$self_pull_detail"
  PULL_OUTPUT=""
  if [[ "$self_pull_protocol" == "2" ]]; then
    PULL_PRE="$self_pull_old"
    PULL_POST="$self_pull_new"
  else
    # Legacy upgrade: the previous script carried only the detail line.
    resolve_legacy_pull_detail "$self_pull_detail"
    PULL_PRE="$cli_pull_pre"
    PULL_POST="$cli_pull_post"
  fi
else
  pull_repo "$root"
  show_pull_row bob-cli
fi
cli_pull_state="$PULL_STATE"
cli_pull_detail="$PULL_DETAIL"
cli_pull_output="$PULL_OUTPUT"
cli_pull_pre="$PULL_PRE"
cli_pull_post="$PULL_POST"
cli_warning=0
if [[ "$PULL_STATE" == warn ]]; then
  cli_warning=1
fi

if [[ "$PULL_STATE" == updated && -z "$self_pull_state" ]]; then
  export BOB_INSTALL_ALL_SELF_PULL="$PULL_STATE"
  export BOB_INSTALL_ALL_SELF_PULL_DETAIL="$PULL_DETAIL"
  export BOB_INSTALL_ALL_PROTOCOL=2
  export BOB_INSTALL_ALL_SELF_PULL_OLD="$PULL_PRE"
  export BOB_INSTALL_ALL_SELF_PULL_NEW="$PULL_POST"
  export BOB_INSTALL_ALL_ELAPSED="$SECONDS"
  export BOB_INSTALL_ALL_HEADER_DONE=1
  export BOB_INSTALL_ALL_CLONES_OFFERED=1
  export BOB_INSTALL_ALL_PLUGINS_CLONE="$plugins_clone_state"
  export BOB_INSTALL_ALL_MAC_CAPTURE_CLONE="$mac_capture_clone_state"
  exec "$root/scripts/install_all" "$@"
fi

# All pulls finish before the first build, so the three source snapshots are
# seconds apart and the digest can show every repo's changes up front.
PULL_STATE=""; PULL_DETAIL=""; PULL_OUTPUT=""; PULL_PRE=""; PULL_POST=""
if [[ "$plugins_clone_state" == cloned ]]; then
  fresh_clone_result "$plugins_dir"
  show_pull_row bob-plugins
elif plugins_eligible; then
  pull_repo "$plugins_dir"
  show_pull_row bob-plugins
fi
plugins_pull_state="$PULL_STATE"
plugins_pull_detail="$PULL_DETAIL"
plugins_pull_output="$PULL_OUTPUT"
plugins_pull_pre="$PULL_PRE"
plugins_pull_post="$PULL_POST"

PULL_STATE=""; PULL_DETAIL=""; PULL_OUTPUT=""; PULL_PRE=""; PULL_POST=""
if [[ "$mac_capture_clone_state" == cloned ]]; then
  fresh_clone_result "$mac_capture_dir"
  show_pull_row bob-mac-capture
elif mac_capture_eligible; then
  pull_repo "$mac_capture_dir"
  show_pull_row bob-mac-capture
fi
maccap_pull_state="$PULL_STATE"
maccap_pull_detail="$PULL_DETAIL"
maccap_pull_output="$PULL_OUTPUT"
maccap_pull_pre="$PULL_PRE"
maccap_pull_post="$PULL_POST"

print_digest
counting_rows=1
print_plan

cli_start="$SECONDS"
banner 35 '🦀' 'BOB-CLI  1/3'
command_line "just --justfile $(display_path "$root/justfile") install"
if (cd "$root" && just --justfile "$root/justfile" install); then
  add_runner_rows bob-cli
  cli_sha="$(git -C "$root" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
  cli_detail="$cli_pull_detail · installed @ $cli_sha"
  if (( cli_warning )); then
    glyph_line 33 '  ' '⚠' "$cli_detail"
    add_summary bob-cli warn "$cli_detail" "$(format_duration "$((SECONDS - cli_start))")"
    WARNINGS=$((WARNINGS + cli_warning))
  else
    glyph_line 32 '  ' '✓' "$cli_detail"
    add_summary bob-cli ok "$cli_detail" "$(format_duration "$((SECONDS - cli_start))")"
  fi
else
  cli_status=$?
  add_runner_rows bob-cli
  if (( cli_status == 130 )); then
    interrupt_run
  fi
  cli_detail="$cli_pull_detail · install failed (exit $cli_status)"
  glyph_line 31 '  ' '✗' "$cli_detail"
  FAILURES=$((FAILURES + 1))
  add_summary bob-cli fail "$cli_detail" "$(format_duration "$((SECONDS - cli_start))")"
fi

plugin_step
mac_capture_step
obsidian_step

counting_rows=0
banner 1 '✨' 'SUMMARY'
print_summary
total_duration="$(format_duration "$((SECONDS - total_start))")"
plan_clause=""
if [[ -f "$ui_run_dir/plan.json" ]]; then
  plan_clause="$(install_ui plan --record "$ui_run_dir/plan.json" --elapsed "$SECONDS" 2>/dev/null || true)"
fi
if (( FAILURES > 0 )); then
  if [[ "$FAILURES" -eq 1 ]]; then plural=''; else plural='S'; fi
  final_text="$FAILURES STEP$plural FAILED · $total_duration"
  if (( use_color )); then
    printf '\n  \033[31m✗  %s%s\033[0m\n' "$final_text" "$plan_clause"
  else
    printf '\n  ✗  %s%s\n' "$final_text" "$plan_clause"
  fi
  print_replay
  completion_cues "$final_text" "$SECONDS"
  exit 1
elif (( WARNINGS > 0 )); then
  if [[ "$WARNINGS" -eq 1 ]]; then plural=''; else plural='S'; fi
  final_text="INSTALLED WITH $WARNINGS WARNING$plural · $total_duration"
  if (( use_color )); then
    printf '\n  \033[33m⚠  %s%s\033[0m\n' "$final_text" "$plan_clause"
  else
    printf '\n  ⚠  %s%s\n' "$final_text" "$plan_clause"
  fi
else
  final_text="ALL INSTALLED · $total_duration"
  if (( use_color )); then
    printf '\n  \033[32m✓  %s%s\033[0m\n' "$final_text" "$plan_clause"
  else
    printf '\n  ✓  %s%s\n' "$final_text" "$plan_clause"
  fi
fi
print_replay
completion_cues "$final_text" "$SECONDS"
