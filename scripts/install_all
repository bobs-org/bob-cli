#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/install_all [-h]

Pull and install bob-cli from this checkout, then pull and deploy the sibling
bob-plugins and bob-mac-capture checkouts that live next to it. When a sibling
it would install is missing and the run is interactive, it first asks whether
to clone it over SSH from git@github.com:bobs-org/<repo>.git; otherwise that
sibling is skipped. When the plugin sync changes the vault, a running Obsidian
is then restarted so it loads the new plugins. On macOS it posts a Notification
Center banner before that restart. Usually run through `just install-all`.

Options:
  -h, --help  Show this help and exit.
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

if ! command -v git >/dev/null 2>&1; then
  printf 'scripts/install_all: git is required on PATH\n' >&2
  exit 1
fi
if ! command -v just >/dev/null 2>&1; then
  printf 'scripts/install_all: just is required on PATH\n' >&2
  exit 1
fi

if [[ -n "${BOB_INSTALL_ALL_ELAPSED:-}" ]]; then
  SECONDS="$BOB_INSTALL_ALL_ELAPSED"
else
  SECONDS=0
fi
self_pull_state="${BOB_INSTALL_ALL_SELF_PULL:-}"
self_pull_detail="${BOB_INSTALL_ALL_SELF_PULL_DETAIL:-}"
header_done="${BOB_INSTALL_ALL_HEADER_DONE:-}"
clones_offered="${BOB_INSTALL_ALL_CLONES_OFFERED:-}"
plugins_clone_state="${BOB_INSTALL_ALL_PLUGINS_CLONE:-}"
mac_capture_clone_state="${BOB_INSTALL_ALL_MAC_CAPTURE_CLONE:-}"
unset BOB_INSTALL_ALL_ELAPSED BOB_INSTALL_ALL_SELF_PULL \
  BOB_INSTALL_ALL_SELF_PULL_DETAIL BOB_INSTALL_ALL_HEADER_DONE \
  BOB_INSTALL_ALL_CLONES_OFFERED BOB_INSTALL_ALL_PLUGINS_CLONE \
  BOB_INSTALL_ALL_MAC_CAPTURE_CLONE

script_dir="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$script_dir/.." && pwd)"
parent="$(dirname "$root")"
plugins_dir="$parent/bob-plugins"
mac_capture_dir="$parent/bob-mac-capture"
clone_base='git@github.com:bobs-org'
obsidian_dir="${BOB_DIR:-$HOME/bob}/.obsidian"
total_start=0
pull_tmp_file=""
PULL_STATE=""
PULL_DETAIL=""
PULL_OUTPUT=""
CLONE_STATE=""
CLONE_SECTION_SHOWN=0
FAILURES=0
WARNINGS=0
PLUGINS_CHANGED=0
# Remembers a restart still owed after a sync that copied files but then
# skipped or failed the Obsidian restart, so a later run retries even when
# the vault is already in sync.
restart_marker="${XDG_STATE_HOME:-$HOME/.local/state}/bob-cli/install-all/obsidian-restart-pending"
declare -a summary_names=()
declare -a summary_glyphs=()
declare -a summary_details=()
declare -a summary_durations=()
declare -a summary_colors=()

cleanup() {
  if [[ -n "$pull_tmp_file" ]]; then
    rm -f "$pull_tmp_file"
  fi
}
trap cleanup EXIT

if [[ -t 1 && -z "${NO_COLOR+x}" ]]; then
  use_color=1
else
  use_color=0
fi

display_path() {
  local path="$1"
  if [[ "$path" == "$HOME" ]]; then
    printf '%s' '~'
  elif [[ "$path" == "$HOME/"* ]]; then
    printf '%s/%s' '~' "${path#"$HOME"/}"
  else
    printf '%s' "$path"
  fi
}

paint() {
  local color="$1"
  local value="$2"
  if [[ "$use_color" -eq 1 ]]; then
    printf '\033[%sm%s\033[0m' "$color" "$value"
  else
    printf '%s' "$value"
  fi
}

banner() {
  local color="$1"
  local icon="$2"
  local title="$3"
  # Keep this 48-character rule in sync with the justfile's _banner recipe.
  local rule='────────────────────────────────────────────────'
  if [[ "$use_color" -eq 1 ]]; then
    printf '\n%s  \033[1;%sm%s\033[0m\n\033[%sm%s\033[0m\n' \
      "$icon" "$color" "$title" "$color" "$rule"
  else
    printf '\n%s  %s\n%s\n' "$icon" "$title" "$rule"
  fi
}

command_line() {
  if [[ "$use_color" -eq 1 ]]; then
    printf '  \033[2m$ %s\033[0m\n' "$1"
  else
    printf '  $ %s\n' "$1"
  fi
}

# delay keeps osascript alive long enough for Notification Center to accept the banner.
# || true: a missing permission or a failed osascript must not change the restart or exit.
notify_mac() {
  local title="$1" body="$2"
  command_line "osascript display notification \"$body\" with title \"$title\" subtitle \"bob install-all\" sound name \"default\""
  osascript - "$title" "$body" <<'APPLESCRIPT' || true
on run argv
  display notification (item 2 of argv) with title (item 1 of argv) subtitle "bob install-all" sound name "default"
  delay 0.5
end run
APPLESCRIPT
}

glyph_line() {
  local color="$1"
  local prefix="$2"
  local glyph="$3"
  local detail="$4"
  printf '%s' "$prefix"
  paint "$color" "$glyph"
  printf ' %s\n' "$detail"
}

dim_diagnostics() {
  local output="$1"
  [[ -n "$output" ]] || return 0
  printf '%s\n' "$output" | while IFS= read -r line; do
    if [[ "$use_color" -eq 1 ]]; then
      printf '  \033[2m    %s\033[0m\n' "$line"
    else
      printf '      %s\n' "$line"
    fi
  done
}

format_duration() {
  local seconds="$1"
  if (( seconds < 60 )); then
    printf '%ss' "$seconds"
  else
    printf '%dm %02ds' "$((seconds / 60))" "$((seconds % 60))"
  fi
}

add_summary() {
  local name="$1"
  local status="$2"
  local detail="$3"
  local duration="$4"
  local glyph color
  case "$status" in
    ok) glyph='✓'; color=32 ;;
    warn) glyph='⚠'; color=33 ;;
    fail) glyph='✗'; color=31 ;;
    restart) glyph='↻'; color=36 ;;
    *) glyph='–'; color=2 ;;
  esac
  summary_names[${#summary_names[@]}]="$name"
  summary_glyphs[${#summary_glyphs[@]}]="$glyph"
  summary_details[${#summary_details[@]}]="$detail"
  summary_durations[${#summary_durations[@]}]="$duration"
  summary_colors[${#summary_colors[@]}]="$color"
}

print_summary() {
  local i
  for i in "${!summary_names[@]}"; do
    printf '  '
    paint "${summary_colors[$i]}" "${summary_glyphs[$i]}"
    printf '  %-16s %s' "${summary_names[$i]}" "${summary_details[$i]}"
    if [[ -n "${summary_durations[$i]}" ]]; then
      printf '  %s' "${summary_durations[$i]}"
    fi
    printf '\n'
  done
}

pull_repo() {
  local dir="$1"
  local old_sha new_sha count pull_status
  PULL_OUTPUT=""
  if ! git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    PULL_STATE=none
    PULL_DETAIL='not a git checkout'
    return 0
  fi
  if ! old_sha="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null)"; then
    PULL_STATE=none
    PULL_DETAIL='not a git checkout'
    return 0
  fi
  pull_tmp_file="$(mktemp "${TMPDIR:-/tmp}/bob-install-all.XXXXXX")"
  command_line "git -C $(display_path "$dir") pull --ff-only --no-rebase"
  if git -C "$dir" pull --ff-only --no-rebase >"$pull_tmp_file" 2>&1; then
    pull_status=0
  else
    pull_status=$?
  fi
  if (( pull_status != 0 )); then
    PULL_STATE=warn
    PULL_DETAIL='pull failed — using local checkout'
    PULL_OUTPUT="$(cat "$pull_tmp_file")"
  else
    new_sha="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || printf '%s' "$old_sha")"
    if [[ "$old_sha" != "$new_sha" ]]; then
      count="$(git -C "$dir" rev-list --count "$old_sha..$new_sha" 2>/dev/null || printf '0')"
      PULL_STATE=updated
      if [[ "$count" == 1 ]]; then
        PULL_DETAIL="1 new commit · $old_sha → $new_sha"
      else
        PULL_DETAIL="$count new commits · $old_sha → $new_sha"
      fi
    else
      PULL_STATE=current
      PULL_DETAIL="up to date · $new_sha"
    fi
  fi
  rm -f "$pull_tmp_file"
  pull_tmp_file=""
}

show_pull_result() {
  case "$PULL_STATE" in
    cloned)
      glyph_line 32 '  ⇣  clone  ' '✓' "$PULL_DETAIL"
      ;;
    updated|current)
      glyph_line 32 '  ⇣  pull   ' '✓' "$PULL_DETAIL"
      ;;
    warn)
      glyph_line 33 '  ⇣  pull   ' '⚠' "$PULL_DETAIL"
      dim_diagnostics "$PULL_OUTPUT"
      ;;
    *)
      glyph_line 2 '  ⇣  pull   ' '–' "$PULL_DETAIL"
      ;;
  esac
}

# Asks [y/N] and clones on yes. Sets CLONE_STATE to cloned, failed, or "".
offer_clone() {
  local name="$1" dir="$2" url answer sha
  url="$clone_base/$name.git"
  CLONE_STATE=''
  if (( CLONE_SECTION_SHOWN == 0 )); then
    banner 33 '📥' 'MISSING CHECKOUTS'
    CLONE_SECTION_SHOWN=1
  fi
  printf '  %s is missing at %s\n' "$name" "$(display_path "$dir")"
  printf '  Clone it from %s? [y/N] ' "$url"
  if ! read -r answer; then
    answer=''
    printf '\n'
  fi
  case "$answer" in
    y|Y|yes|Yes|YES) ;;
    *)
      glyph_line 2 '  ' '–' "not cloned · skipping $name"
      return 0
      ;;
  esac
  # Streams raw so SSH host-key and passphrase prompts reach the terminal.
  command_line "git clone $url $(display_path "$dir")"
  if git clone "$url" "$dir"; then
    sha="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
    glyph_line 32 '  ' '✓' "cloned · $sha"
    CLONE_STATE=cloned
  else
    glyph_line 31 '  ' '✗' 'clone failed'
    CLONE_STATE=failed
  fi
}

# Offers only siblings this run would install, and only when a person can answer.
offer_missing_clones() {
  CLONE_SECTION_SHOWN=0
  [[ -t 0 && -t 1 ]] || return 0
  if [[ ! -e "$plugins_dir" && -d "$obsidian_dir" ]]; then
    offer_clone bob-plugins "$plugins_dir"
    plugins_clone_state="$CLONE_STATE"
  fi
  if [[ "$(uname -s)" == Darwin && ! -e "$mac_capture_dir" ]]; then
    offer_clone bob-mac-capture "$mac_capture_dir"
    mac_capture_clone_state="$CLONE_STATE"
  fi
}

fresh_clone_result() {
  PULL_OUTPUT=''
  PULL_STATE=cloned
  PULL_DETAIL="cloned · $(git -C "$1" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
}

pull_detail_for_summary() {
  printf '%s' "$PULL_DETAIL"
}

extract_json_integer() {
  local key="$1"
  local json="$2"
  printf '%s\n' "$json" | sed -n \
    "s/.*\"$key\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" | head -n 1
}

mark_restart_pending() {
  mkdir -p "$(dirname "$restart_marker")" || true
  : >"$restart_marker" || true
}

clear_restart_pending() {
  rm -f "$restart_marker"
}

plugin_step() {
  local step_start duration pull_detail step_warning=0
  local bob_bin output count synced drift plugin_detail
  local preview pending copied_clause
  banner 34 '🧩' 'BOB-PLUGINS  2/3'
  step_start="$SECONDS"
  if [[ ! -d "$plugins_dir" ]]; then
    if [[ "$plugins_clone_state" == failed ]]; then
      plugin_detail="clone failed · retry: git clone $clone_base/bob-plugins.git $(display_path "$plugins_dir")"
      glyph_line 31 '  ' '✗' "$plugin_detail"
      FAILURES=$((FAILURES + 1))
      add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
      return 0
    fi
    plugin_detail="skipped · missing checkout · git clone $clone_base/bob-plugins.git $(display_path "$plugins_dir")"
    glyph_line 2 '  ' '–' "$plugin_detail"
    add_summary 'bob-plugins' skip "$plugin_detail" ''
    return 0
  fi
  if [[ ! -d "$plugins_dir/plugins" ]]; then
    plugin_detail="doesn't look like bob-plugins"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  if [[ ! -d "$obsidian_dir" ]]; then
    plugin_detail="skipped · no Obsidian vault at $(display_path "$obsidian_dir")"
    glyph_line 2 '  ' '–' "$plugin_detail"
    add_summary 'bob-plugins' skip "$plugin_detail" ''
    return 0
  fi

  if [[ "$plugins_clone_state" == cloned ]]; then
    fresh_clone_result "$plugins_dir"
  else
    pull_repo "$plugins_dir"
  fi
  show_pull_result
  pull_detail="$(pull_detail_for_summary)"
  if [[ "$PULL_STATE" == warn ]]; then
    step_warning=$((step_warning + 1))
  fi
  if [[ -x "${CARGO_INSTALL_ROOT:-${CARGO_HOME:-$HOME/.cargo}}/bin/bob" ]]; then
    bob_bin="${CARGO_INSTALL_ROOT:-${CARGO_HOME:-$HOME/.cargo}}/bin/bob"
  else
    bob_bin="$(command -v bob || true)"
  fi
  if [[ -z "$bob_bin" ]]; then
    plugin_detail="$pull_detail · bob binary not found in the install root or on PATH"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  command_line "bob plugins sync --dry-run --format json --no-pull --repo $(display_path "$plugins_dir")"
  if ! preview="$("$bob_bin" plugins sync --dry-run --format json --no-pull --repo "$plugins_dir")"; then
    plugin_detail="$pull_detail · could not preview plugin sync"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  pending="$(extract_json_integer copied "$preview")"
  if [[ -z "$pending" ]]; then
    plugin_detail="$pull_detail · could not read plugin sync preview"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  if (( pending > 0 )); then
    PLUGINS_CHANGED=1
    mark_restart_pending
  fi
  if (( pending == 1 )); then
    copied_clause=' · 1 file copied'
  elif (( pending > 1 )); then
    copied_clause=" · $pending files copied"
  else
    copied_clause=''
  fi
  command_line "bob plugins sync --no-pull --repo $(display_path "$plugins_dir")"
  if "$bob_bin" plugins sync --no-pull --repo "$plugins_dir"; then
    output=''
  else
    plugin_detail="$pull_detail · sync failed"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  command_line "bob plugins list --no-pull --repo $(display_path "$plugins_dir") --format json"
  if ! output="$("$bob_bin" plugins list --no-pull --repo "$plugins_dir" --format json)"; then
    plugin_detail="$pull_detail · could not verify plugin sync"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  count="$(extract_json_integer count "$output")"
  synced="$(extract_json_integer synced "$output")"
  drift="$(extract_json_integer drift "$output")"
  if [[ -z "$count" || -z "$synced" || -z "$drift" ]]; then
    plugin_detail="$pull_detail · could not read plugin sync counts"
    glyph_line 31 '  ' '✗' "$plugin_detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-plugins' fail "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  if (( drift == 0 )); then
    plugin_detail="$pull_detail$copied_clause · $synced/$count plugins in sync"
    if (( step_warning > 0 )); then
      glyph_line 33 '  ' '⚠' "$plugin_detail"
      add_summary 'bob-plugins' warn "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
      WARNINGS=$((WARNINGS + step_warning))
    else
      glyph_line 32 '  ' '✓' "$plugin_detail"
      add_summary 'bob-plugins' ok "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    fi
  else
    step_warning=$((step_warning + 1))
    plugin_detail="$pull_detail$copied_clause · $synced/$count plugins in sync; $drift drifted (dirty in vault — review, then bob plugins sync -F)"
    glyph_line 33 '  ' '⚠' "$plugin_detail"
    add_summary 'bob-plugins' warn "$plugin_detail" "$(format_duration "$((SECONDS - step_start))")"
    WARNINGS=$((WARNINGS + step_warning))
  fi
}

mac_capture_step() {
  local step_start pull_detail step_warning=0 status detail install_status
  banner 32 '🍎' 'BOB-MAC-CAPTURE  3/3'
  step_start="$SECONDS"
  if [[ "$(uname -s)" != Darwin ]]; then
    detail='skipped · macOS only'
    glyph_line 2 '  ' '–' "$detail"
    add_summary 'bob-mac-capture' skip "$detail" ''
    return 0
  fi
  if [[ ! -d "$mac_capture_dir" ]]; then
    if [[ "$mac_capture_clone_state" == failed ]]; then
      detail="clone failed · retry: git clone $clone_base/bob-mac-capture.git $(display_path "$mac_capture_dir")"
      glyph_line 31 '  ' '✗' "$detail"
      FAILURES=$((FAILURES + 1))
      add_summary 'bob-mac-capture' fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
      return 0
    fi
    detail="skipped · missing checkout · git clone $clone_base/bob-mac-capture.git $(display_path "$mac_capture_dir")"
    glyph_line 2 '  ' '–' "$detail"
    add_summary 'bob-mac-capture' skip "$detail" ''
    return 0
  fi
  if [[ ! -f "$mac_capture_dir/Scripts/install.sh" ]]; then
    detail="doesn't look like bob-mac-capture (missing Scripts/install.sh)"
    glyph_line 31 '  ' '✗' "$detail"
    FAILURES=$((FAILURES + 1))
    add_summary 'bob-mac-capture' fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
    return 0
  fi
  if [[ "$mac_capture_clone_state" == cloned ]]; then
    fresh_clone_result "$mac_capture_dir"
  else
    pull_repo "$mac_capture_dir"
  fi
  show_pull_result
  pull_detail="$(pull_detail_for_summary)"
  if [[ "$PULL_STATE" == warn ]]; then
    step_warning=$((step_warning + 1))
  fi
  command_line "just --justfile $(display_path "$mac_capture_dir/justfile") install $(display_path "$HOME/Applications") ${CODESIGN_IDENTITY:--}"
  if (cd "$mac_capture_dir" && just --justfile "$mac_capture_dir/justfile" install "$HOME/Applications" "${CODESIGN_IDENTITY:--}"); then
    status=ok
    detail="$pull_detail · installed $(display_path "$HOME/Applications/Bob Mac Capture.app")"
  else
    install_status=$?
    if (( install_status == 72 )); then
      status=warn
      step_warning=$((step_warning + 1))
      detail="$pull_detail · installed; restart it via Bob → Restart Bob Mac Capture"
    else
      status=fail
      detail="$pull_detail · install failed (exit $install_status)"
    fi
  fi
  case "$status" in
    ok)
      if (( step_warning > 0 )); then
        glyph_line 33 '  ' '⚠' "$detail"
        add_summary 'bob-mac-capture' warn "$detail" "$(format_duration "$((SECONDS - step_start))")"
        WARNINGS=$((WARNINGS + step_warning))
      else
        glyph_line 32 '  ' '✓' "$detail"
        add_summary 'bob-mac-capture' ok "$detail" "$(format_duration "$((SECONDS - step_start))")"
      fi
      ;;
    warn)
      glyph_line 33 '  ' '⚠' "$detail"
      add_summary 'bob-mac-capture' warn "$detail" "$(format_duration "$((SECONDS - step_start))")"
      WARNINGS=$((WARNINGS + step_warning))
      ;;
    *)
      glyph_line 31 '  ' '✗' "$detail"
      FAILURES=$((FAILURES + 1))
      add_summary 'bob-mac-capture' fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
      ;;
  esac
}

obsidian_step() {
  local step_start detail running i cli reason pending_suffix
  banner 36 '🔄' 'OBSIDIAN'
  step_start="$SECONDS"
  if (( PLUGINS_CHANGED == 1 )); then
    reason='plugins changed'
  elif [[ -f "$restart_marker" ]]; then
    reason='restart pending from an earlier run'
  else
    detail='plugins unchanged · restart not needed'
    glyph_line 2 '  ' '–' "$detail"
    add_summary obsidian skip "$detail" ''
    return 0
  fi
  if (( PLUGINS_CHANGED == 0 )); then
    pending_suffix=' · pending from an earlier run'
  else
    pending_suffix=''
  fi
  if (( FAILURES > 0 )); then
    if [[ "$(uname -s)" == Darwin ]]; then
      if (( PLUGINS_CHANGED == 1 )); then
        notify_mac 'Obsidian needs a restart' \
          'Plugins changed, but a step failed. Fix it and rerun just install-all.'
      else
        notify_mac 'Obsidian needs a restart' \
          'An earlier plugin update still needs a restart, but a step failed. Fix it and rerun just install-all.'
      fi
    fi
    detail="$reason; not restarted: a step failed — fix it and rerun just install-all"
    glyph_line 2 '  ' '–' "$detail"
    add_summary obsidian skip "$detail" ''
    return 0
  fi
  case "$(uname -s)" in
    Darwin)
      if ! running="$(osascript -e 'application id "md.obsidian" is running' 2>/dev/null)"; then
        detail='could not check whether Obsidian is running'
        glyph_line 31 '  ' '✗' "$detail"
        FAILURES=$((FAILURES + 1))
        add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
        return 0
      fi
      if [[ "$running" != true ]]; then
        detail='not running · plugins load on next launch'
        glyph_line 2 '  ' '–' "$detail"
        add_summary obsidian skip "$detail" ''
        clear_restart_pending
        return 0
      fi
      if (( PLUGINS_CHANGED == 1 )); then
        notify_mac 'Restarting Obsidian' \
          'Plugins changed. It will reopen in a moment.'
      else
        notify_mac 'Restarting Obsidian' \
          'Finishing an earlier plugin update. It will reopen in a moment.'
      fi
      command_line "osascript -e 'tell application id \"md.obsidian\" to quit'"
      if ! osascript -e 'tell application id "md.obsidian" to quit'; then
        notify_mac 'Obsidian needs a restart' \
          'Quit failed. Allow Terminal in Automation, then rerun just install-all.'
        detail='quit failed · allow Terminal in System Settings → Privacy & Security → Automation'
        glyph_line 31 '  ' '✗' "$detail"
        FAILURES=$((FAILURES + 1))
        add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
        return 0
      fi
      i=0
      while (( i < 60 )); do
        if ! running="$(osascript -e 'application id "md.obsidian" is running' 2>/dev/null)"; then
          detail='could not check whether Obsidian quit'
          glyph_line 31 '  ' '✗' "$detail"
          FAILURES=$((FAILURES + 1))
          add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
          return 0
        fi
        if [[ "$running" != true ]] && ! pgrep -x Obsidian >/dev/null 2>&1; then
          break
        fi
        sleep 0.5
        i=$((i + 1))
      done
      if (( i >= 60 )); then
        notify_mac 'Obsidian needs a restart' \
          'Obsidian did not quit. Close any open dialog, then restart it to load the new plugins.'
        detail='Obsidian did not quit within 30s (an open dialog?) — not relaunching'
        glyph_line 31 '  ' '✗' "$detail"
        FAILURES=$((FAILURES + 1))
        add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
        return 0
      fi
      command_line 'open -b md.obsidian'
      if ! open -b md.obsidian; then
        notify_mac 'Obsidian needs a restart' \
          'Obsidian quit but did not reopen. Open it to load the new plugins.'
        detail='relaunch failed'
        glyph_line 31 '  ' '✗' "$detail"
        FAILURES=$((FAILURES + 1))
        add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
        return 0
      fi
      i=0
      while (( i < 30 )); do
        if running="$(osascript -e 'application id "md.obsidian" is running' 2>/dev/null)" && [[ "$running" == true ]]; then
          detail="restarted${pending_suffix}"
          glyph_line 36 '  ' '↻' "$detail"
          add_summary obsidian restart "$detail" "$(format_duration "$((SECONDS - step_start))")"
          clear_restart_pending
          return 0
        fi
        sleep 0.5
        i=$((i + 1))
      done
      detail='relaunch requested; not confirmed yet'
      glyph_line 33 '  ' '⚠' "$detail"
      WARNINGS=$((WARNINGS + 1))
      add_summary obsidian warn "$detail" "$(format_duration "$((SECONDS - step_start))")"
      clear_restart_pending
      ;;
    Linux)
      if ! pgrep -x obsidian >/dev/null 2>&1; then
        detail='not running · plugins load on next launch'
        glyph_line 2 '  ' '–' "$detail"
        add_summary obsidian skip "$detail" ''
        clear_restart_pending
        return 0
      fi
      cli="$HOME/.local/bin/obsidian"
      if [[ ! -x "$cli" ]]; then
        detail='running; restart it manually to load the new plugins'
        glyph_line 33 '  ' '⚠' "$detail"
        WARNINGS=$((WARNINGS + 1))
        add_summary obsidian warn "$detail" "$(format_duration "$((SECONDS - step_start))")"
        clear_restart_pending
        return 0
      fi
      command_line "$(display_path "$cli") restart"
      if "$cli" restart; then
        detail="restart requested${pending_suffix}"
        glyph_line 36 '  ' '↻' "$detail"
        add_summary obsidian restart "$detail" "$(format_duration "$((SECONDS - step_start))")"
        clear_restart_pending
      else
        detail='Obsidian CLI restart failed'
        glyph_line 31 '  ' '✗' "$detail"
        FAILURES=$((FAILURES + 1))
        add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
      fi
      ;;
    *)
      detail="unsupported OS: $(uname -s)"
      glyph_line 31 '  ' '✗' "$detail"
      FAILURES=$((FAILURES + 1))
      add_summary obsidian fail "$detail" "$(format_duration "$((SECONDS - step_start))")"
      ;;
  esac
}

if [[ "$header_done" != 1 ]]; then
  banner 36 '🚀' 'INSTALL ALL'
  printf '  from     %s\n' "$(display_path "$parent")"
  printf '  then     restart Obsidian if the plugin sync changes the vault\n'
  offer_missing_clones
  banner 35 '🦀' 'BOB-CLI  1/3'
elif [[ "$clones_offered" != 1 ]]; then
  # Re-exec'd by an installer that predates the clone offer.
  offer_missing_clones
  if (( CLONE_SECTION_SHOWN == 1 )); then
    banner 35 '🦀' 'BOB-CLI  1/3'
  fi
fi

cli_start=0
if [[ -n "$self_pull_state" ]]; then
  PULL_STATE="$self_pull_state"
  PULL_DETAIL="$self_pull_detail"
else
  pull_repo "$root"
  show_pull_result
fi
cli_pull_detail="$PULL_DETAIL"
cli_warning=0
if [[ "$PULL_STATE" == warn ]]; then
  cli_warning=1
fi

if [[ "$PULL_STATE" == updated && -z "$self_pull_state" ]]; then
  export BOB_INSTALL_ALL_SELF_PULL="$PULL_STATE"
  export BOB_INSTALL_ALL_SELF_PULL_DETAIL="$PULL_DETAIL"
  export BOB_INSTALL_ALL_ELAPSED="$SECONDS"
  export BOB_INSTALL_ALL_HEADER_DONE=1
  export BOB_INSTALL_ALL_CLONES_OFFERED=1
  export BOB_INSTALL_ALL_PLUGINS_CLONE="$plugins_clone_state"
  export BOB_INSTALL_ALL_MAC_CAPTURE_CLONE="$mac_capture_clone_state"
  exec "$root/scripts/install_all" "$@"
fi

command_line "just --justfile $(display_path "$root/justfile") install"
if (cd "$root" && just --justfile "$root/justfile" install); then
  cli_sha="$(git -C "$root" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
  cli_detail="$cli_pull_detail · installed @ $cli_sha"
  if (( cli_warning )); then
    glyph_line 33 '  ' '⚠' "$cli_detail"
    add_summary bob-cli warn "$cli_detail" "$(format_duration "$((SECONDS - cli_start))")"
    WARNINGS=$((WARNINGS + cli_warning))
  else
    glyph_line 32 '  ' '✓' "$cli_detail"
    add_summary bob-cli ok "$cli_detail" "$(format_duration "$((SECONDS - cli_start))")"
  fi
else
  cli_status=$?
  cli_detail="$cli_pull_detail · install failed (exit $cli_status)"
  glyph_line 31 '  ' '✗' "$cli_detail"
  FAILURES=$((FAILURES + 1))
  add_summary bob-cli fail "$cli_detail" "$(format_duration "$((SECONDS - cli_start))")"
fi

plugin_step
mac_capture_step
obsidian_step

banner 1 '✨' 'SUMMARY'
print_summary
total_duration="$(format_duration "$((SECONDS - total_start))")"
if (( FAILURES > 0 )); then
  if (( use_color )); then
    printf '\n  \033[31m✗  %s STEP%s FAILED · %s\033[0m\n' \
      "$FAILURES" "$([[ "$FAILURES" -eq 1 ]] && printf '' || printf 'S')" "$total_duration"
  else
    printf '\n  ✗  %s STEP%s FAILED · %s\n' \
      "$FAILURES" "$([[ "$FAILURES" -eq 1 ]] && printf '' || printf 'S')" "$total_duration"
  fi
  exit 1
elif (( WARNINGS > 0 )); then
  if (( use_color )); then
    printf '\n  \033[33m⚠  INSTALLED WITH %s WARNING%s · %s\033[0m\n' \
      "$WARNINGS" "$([[ "$WARNINGS" -eq 1 ]] && printf '' || printf 'S')" "$total_duration"
  else
    printf '\n  ⚠  INSTALLED WITH %s WARNING%s · %s\n' \
      "$WARNINGS" "$([[ "$WARNINGS" -eq 1 ]] && printf '' || printf 'S')" "$total_duration"
  fi
else
  if (( use_color )); then
    printf '\n  \033[32m✓  ALL INSTALLED · %s\033[0m\n' "$total_duration"
  else
    printf '\n  ✓  ALL INSTALLED · %s\n' "$total_duration"
  fi
fi
