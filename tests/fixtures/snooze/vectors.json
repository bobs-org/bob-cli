{
  "schema_version": 1,
  "docs": "docs/snooze.md § Conformance vectors. Language-neutral schemas for all six vector groups. Row-model phase populates and executes rows/when/live; mutation-planners completes snooze/wake/cleanup without silently skipping unknown cases (unknown group, runner, or mode is a hard error in the typed loader).",
  "schemas": {
    "rows": "input: {note: string (LF or CRLF daily note), encoding: 'lf'|'crlf'}; expected: {header: number|null (1-based), duplicates: number[] (1-based), rows: [{line, kind: 'active'|'history'|'malformed', hhmm|null, target|null, block|null, embedded: bool, aliased: bool, children: number (count of note-subtree lines), malformed_reason|null, woke|null}]}",
    "when": "input: {input: string, date: 'YYYY-MM-DD', now: 'HH:MM', zone: IANA name}; expected: {hhmm, minutes, rfc3339_contains} | {refusal: 'past'|'next_day'|'dst_gap'|'invalid'}",
    "live": "input: {today: 'YYYY-MM-DD', note_date: 'YYYY-MM-DD', now: 'HH:MM', rows: [{line, minutes|null, history: bool, malformed: bool, resolution: 'found'|'missing'|'ambiguous', route|null, block|null, status|null, is_task: bool, is_event: bool, live_link: bool}]}; expected: {states: [{line, state}], planned: string[] ('route#^block'), blocked: string[], next_wake_at_contains|null, event_lints: number[]}",
    "snooze": "Owned by mutation-planners (add plan): input {note, targets, now}; expected postimage note plus report. Empty until that phase lands.",
    "wake": "Owned by mutation-planners (wake plan): input {note, targets, now}; expected postimage note plus report. Empty until that phase lands.",
    "cleanup": "Owned by mutation-planners (row cleanup): input {note, targets}; expected postimage note. Empty until that phase lands."
  },
  "groups": {
