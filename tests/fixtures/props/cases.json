  {
    "id": "rename-then-edit",
    "note": "---\nname: old\ncreated: 2026-11-22\n---\nbody\n",
    "kind": "note",
    "ops": [
      { "op": "prop.rename", "key": "name", "to": "title" },
      { "op": "prop.set", "key": "title", "value": "new" }
    ],
    "contains": ["title: new", "created: 2026-11-22"],
    "untouched": ["created"]
  },
  {
