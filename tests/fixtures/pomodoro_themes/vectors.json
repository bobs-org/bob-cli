    {
      "name": "rename-moves-hidden-state",
      "events": [
        {
          "raw": "{\"v\":1,\"ts\":\"2026-10-24T09:00:00-04:00\",\"host\":\"mac\",\"kind\":\"theme.hide\",\"key\":\"fixes\",\"name\":\"FIXES\",\"via\":\"bob-mac-capture\"}"
        },
        {
          "raw": "{\"v\":1,\"ts\":\"2026-10-24T10:02:11-04:00\",\"host\":\"apollo\",\"kind\":\"theme.rename\",\"from\":\"fixes\",\"to\":\"fix\",\"from_name\":\"FIXES\",\"to_name\":\"FIX\",\"via\":\"bob-cli\"}"
        }
      ],
      "expected": { "fix": { "hidden": true, "pin": null } }
    },
    {
      "name": "rename-does-not-clobber-target-state",
      "events": [
        {
          "raw": "{\"v\":1,\"ts\":\"2026-10-24T09:00:00-04:00\",\"host\":\"apollo\",\"kind\":\"theme.hide\",\"key\":\"fixes\",\"name\":\"FIXES\",\"via\":\"bob-cli\"}"
        },
        {
          "raw": "{\"v\":1,\"ts\":\"2026-10-24T09:30:00-04:00\",\"host\":\"apollo\",\"kind\":\"theme.color\",\"key\":\"fix\",\"name\":\"FIX\",\"hue\":\"green\",\"via\":\"bob-cli\"}"
        },
        {
          "raw": "{\"v\":1,\"ts\":\"2026-10-24T10:00:00-04:00\",\"host\":\"apollo\",\"kind\":\"theme.rename\",\"from\":\"fixes\",\"to\":\"fix\",\"from_name\":\"FIXES\",\"to_name\":\"FIX\",\"via\":\"bob-cli\"}"
        }
      ],
      "expected": {
        "fix": { "hidden": false, "pin": "green" },
        "fixes": { "hidden": true, "pin": null }
      }
    },
    {
      "name": "events-after-rename-stay-on-old-key",
      "events": [
        {
          "raw": "{\"v\":1,\"ts\":\"2026-10-24T09:00:00-04:00\",\"host\":\"apollo\",\"kind\":\"theme.rename\",\"from\":\"fixes\",\"to\":\"fix\",\"from_name\":\"FIXES\",\"to_name\":\"FIX\",\"via\":\"bob-cli\"}"
        },
        {
          "raw": "{\"v\":1,\"ts\":\"2026-10-24T11:00:00-04:00\",\"host\":\"mac\",\"kind\":\"theme.hide\",\"key\":\"fixes\",\"name\":\"FIXES\",\"via\":\"bob-mac-capture\"}"
        }
      ],
      "expected": { "fixes": { "hidden": true, "pin": null } }
    },
