          "raw": "{\"v\":1,\"ts\":\"2026-10-24T09:02:00-04:00\",\"host\":\"apollo\",\"kind\":\"theme.color\",\"key\":\"blog\",\"name\":\"BLOG\",\"hue\":null,\"via\":\"bob-cli\"}"
