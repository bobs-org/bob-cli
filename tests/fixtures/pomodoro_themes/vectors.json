          "raw": "{\"v\":1,\"ts\":\"2026-10-24T09:00:00-04:00\",\"host\":\"apollo\",\"kind\":\"theme.hide\",\"key\":\"fixes\",\"name\":\"FIXES\",\"via\":\"bob-cli\"}"
        },
        {
          "raw": "{\"v\":1,\"ts\":\"2026-10-24T09:30:00-04:00\",\"host\":\"apollo\",\"kind\":\"theme.color\",\"key\":\"fix\",\"name\":\"FIX\",\"hue\":\"green\",\"via\":\"bob-cli\"}"
        },
        {
          "raw": "{\"v\":1,\"ts\":\"2026-10-24T10:00:00-04:00\",\"host\":\"apollo\",\"kind\":\"theme.rename\",\"from\":\"fixes\",\"to\":\"fix\",\"from_name\":\"FIXES\",\"to_name\":\"FIX\",\"via\":\"bob-cli\"}"
        }
