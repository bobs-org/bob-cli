      "after": " ((api",
      "expect": null
    },
    {
      "name": "mid-word opener never opens",
      "before": "f((x",
      "after": "",
      "expect": null
    },
    {
      "name": "triple paren never opens",
      "before": "(((x",
      "after": "",
      "expect": null
    },
    {
      "name": "escaped paren never opens",
      "before": "\\((x",
      "after": "",
      "expect": null
    },
    {
      "name": "inside an inline code span",
      "before": "see `((x",
      "after": "`",
      "expect": null
    },
    {
      "name": "inside a double-backtick code span",
      "before": "see ``a ((b",
      "after": "``",
      "expect": null
    },
    {
      "name": "unclosed backtick covers the rest of the line",
      "before": "see `((x",
      "after": "",
      "expect": null
    },
    {
      "name": "escaped backtick stays literal",
      "before": "see \\` ((x",
      "after": "",
      "expect": {
        "query": "x",
        "replaced": "((x",
        "closed": false
      }
    },
    {
      "name": "code span earlier on the line",
      "before": "`code` ((x",
      "after": "",
      "expect": {
        "query": "x",
        "replaced": "((x",
        "closed": false
      }
    },
    {
      "name": "inside a closed wikilink",
      "before": "[[a ((b",
      "after": "]]",
      "expect": null
    },
    {
      "name": "after an unclosed wikilink",
      "before": "[[a ((b",
      "after": " more",
      "expect": null
    },
    {
      "name": "after a closed wikilink",
      "before": "[[a]] ((b",
      "after": "",
      "expect": {
        "query": "b",
        "replaced": "((b",
        "closed": false
      }
    },
    {
      "name": "closed token with the caret before the opener",
      "before": "",
      "after": "((a))",
      "expect": {
        "query": "",
        "replaced": "((a))",
        "closed": true
      }
    },
    {
      "name": "closed token with the caret inside",
      "before": "((a",
      "after": "))",
      "expect": {
        "query": "a",
        "replaced": "((a))",
        "closed": true
      }
    },
    {
      "name": "closed token with the caret between the closers",
      "before": "((a)",
      "after": ")",
      "expect": {
        "query": "a",
        "replaced": "((a))",
        "closed": true
      }
    },
    {
      "name": "closed token with the caret right after the closer",
      "before": "((a))",
      "after": " tomorrow",
      "expect": {
        "query": "a",
        "replaced": "((a))",
        "closed": true
      }
    },
    {
      "name": "one character past the closer",
      "before": "((a)) ",
      "after": "more",
