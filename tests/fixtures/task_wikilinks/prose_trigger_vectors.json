{
  "version": 1,
  "source": "tests/fixtures/task_wikilinks/prose_trigger_vectors.json",
  "cases": [
    {
      "name": "opener at line start",
      "before": "((api",
      "after": "",
      "expect": {
        "query": "api",
        "replaced": "((api",
        "closed": false
      }
    },
    {
      "name": "opener after a space",
      "before": "Superseded by ((api",
      "after": "",
      "expect": {
        "query": "api",
        "replaced": "((api",
        "closed": false
      }
    },
    {
      "name": "opener after a tab",
      "before": "Notes\t((api",
      "after": "",
      "expect": {
        "query": "api",
        "replaced": "((api",
        "closed": false
      }
    },
    {
      "name": "bare opener has an empty query",
      "before": "See ((",
      "after": "",
      "expect": {
        "query": "",
        "replaced": "((",
        "closed": false
      }
    },
    {
      "name": "unclosed token keeps prose after a space",
      "before": "Superseded by ((api",
      "after": " tomorrow",
      "expect": {
        "query": "api",
        "replaced": "((api",
        "closed": false
      }
    },
    {
      "name": "caret on the opener of an unclosed token",
