        "query": "foo",
        "replaced": "((foo",
        "closed": false
      }
    },
    {
      "name": "caret past a lone close paren",
      "before": "((foo)",
      "after": " bar",
      "expect": null
    },
    {
      "name": "query stops at a backtick",
      "before": "((foo",
      "after": "`code`",
      "expect": {
        "query": "foo",
        "replaced": "((foo",
        "closed": false
      }
    },
    {
      "name": "query stops at an open paren",
      "before": "((fo(o",
      "after": "",
      "expect": null
