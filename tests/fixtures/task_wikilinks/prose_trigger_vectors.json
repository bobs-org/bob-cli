    {
      "name": "two tokens with the caret in the second",
      "before": "((a ((b",
      "after": "",
      "expect": {
        "query": "b",
        "replaced": "((b",
        "closed": false
      }
    },
    {
      "name": "two tokens meeting at the caret: last wins",
      "before": "((a ",
      "after": "((b",
      "expect": {
        "query": "",
        "replaced": "((b",
        "closed": false
      }
    },
    {
      "name": "token on the second line",
      "before": "First line\n((sec",
      "after": "",
      "expect": {
        "query": "sec",
        "replaced": "((sec",
        "closed": false
      }
    },
    {
      "name": "token on the second line after CRLF",
      "before": "First line\r\n((sec",
      "after": "",
      "expect": {
        "query": "sec",
        "replaced": "((sec",
        "closed": false
      }
    },
    {
      "name": "token on an earlier line never reaches the caret",
      "before": "((a\nb",
      "after": "",
      "expect": null
    },
    {
      "name": "emoji neighbours",
      "before": "🎉 ((café",
      "after": " ☕",
      "expect": {
        "query": "café",
        "replaced": "((café",
        "closed": false
      }
    },
    {
      "name": "RTL neighbours",
      "before": "שלום ((مرحبا",
