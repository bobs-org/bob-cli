{
  "version": 1,
  "source": "tests/fixtures/log_recall/vectors.json",
  "normalize": [
    { "name": "collapse whitespace and lowercase", "input": "  ATHENA\t Agent  ", "expected": "athena agent" },
    { "name": "compose NFC accents", "input": "cafe\u0301", "expected": "café" },
    { "name": "emoji and CJK", "input": "🎲 東京", "expected": "🎲 東京" },
    { "name": "lowercase Greek", "input": "ÉCOLE", "expected": "école" }
