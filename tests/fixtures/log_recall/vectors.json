        { "text": "flagship", "key": "flagship", "score": 4.0, "recency_rank": 2 },
        { "text": "the agent", "key": "the agent", "score": 0.1, "recency_rank": 1 },
        { "text": "athena agent", "key": "athena agent", "score": 0.1, "recency_rank": 0 },
        { "text": "agentic", "key": "agentic", "score": 0.1, "recency_rank": 5 },
        { "text": "agent", "key": "agent", "score": 0.2, "recency_rank": 3 },
        { "text": "ag", "key": "ag", "score": 0.1, "recency_rank": 6 }
      ],
      "expected": ["ag", "agent", "agentic", "athena agent", "the agent", "flagship"]
    },
    {
      "name": "empty query pins newest then uses frecency",
      "query": "",
      "catalog": [
        { "text": "often used", "key": "often used", "score": 8.0, "recency_rank": 2 },
        { "text": "newest", "key": "newest", "score": 0.1, "recency_rank": 0 },
        { "text": "less used", "key": "less used", "score": 2.0, "recency_rank": 1 }
      ],
      "expected": ["newest", "often used", "less used"]
    },
    {
      "name": "overlay updates existing and inserts new phrase",
      "query": "",
      "catalog": [
        { "text": "Athena Agent", "key": "athena agent", "score": 2.5, "recency_rank": 0 },
        { "text": "Apollo research", "key": "apollo research", "score": 2.0, "recency_rank": 1 }
      ],
      "overlay": [
        { "key": "athena agent", "text": "ATHENA agent", "at": "2026-11-19T10:00:00Z" },
        { "key": "new phrase", "text": "New phrase", "at": "2026-11-19T11:00:00Z" }
      ],
      "expected": ["new phrase", "athena agent", "apollo research"]
    },
    {
      "name": "query with no match",
      "query": "zzzz",
      "catalog": [
        { "text": "athena agent", "key": "athena agent", "score": 1.0, "recency_rank": 0 }
      ],
      "expected": []
    },
    {
      "name": "score and recency ties use key",
      "query": "",
      "catalog": [
        { "text": "zulu", "key": "zulu", "score": 1.0, "recency_rank": 0 },
        { "text": "alpha", "key": "alpha", "score": 1.0, "recency_rank": 0 },
        { "text": "beta", "key": "beta", "score": 0.5, "recency_rank": 1 }
      ],
      "expected": ["alpha", "zulu", "beta"]
    }
  ],
  "machine_samples": [
