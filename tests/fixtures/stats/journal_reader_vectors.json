        {"ts": "2026-10-10T09:00:00+00:00", "day": "2026-10-10", "host": "apollo", "tier": "next", "outcome": "keep", "key": "sase.md#^shared"},
        {"ts": "2026-10-10T10:00:00-04:00", "day": "2026-10-10", "host": "mac", "tier": "next", "outcome": "done", "key": "sase.md#^shared"},
