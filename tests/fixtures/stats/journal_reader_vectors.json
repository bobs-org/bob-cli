{
  "schema": 1,
  "note": "Hand-authored journal reader vectors for the Daily Stats engine. Each case lists raw journal lines (multi-host, duplicate keys, out-of-order timestamps, offset Mix, equal-timestamp ties, unknown outcomes/tiers, pre/post-only days, gap days) plus the days the registry review_closed definition reports as met. Malformed and truncated lines never reach the evaluator; index.rs covers that layer. Expected values pin the reviewed (count) and keep_rate (ratio) built-ins: value, quality, num/den, tier/outcome parts, inferred since, and journal_gap days.",
  "cases": [
    {
      "id": "J1-duplicate-key-keeps-last",
      "description": "One row answered twice on one host; the later timestamp wins and the day counts once.",
      "today": "2026-10-12",
      "dates": ["2026-10-10", "2026-10-11", "2026-10-12"],
      "review_closed": [],
      "events": [
        {"ts": "2026-10-10T05:41:07-04:00", "day": "2026-10-10", "host": "apollo", "tier": "next", "outcome": "keep", "key": "sase.md#^fix"},
        {"ts": "2026-10-10T05:42:00-04:00", "day": "2026-10-10", "host": "apollo", "tier": "next", "outcome": "done", "key": "sase.md#^fix"}
      ],
      "expect": {
        "since": "2026-10-10",
        "reviewed": {
          "2026-10-10": {"value": 1, "quality": "ok", "outcome": {"done": 1}, "tier": {"next": 1}},
          "2026-10-11": {"value": 0, "quality": "ok", "outcome": {}, "tier": {}},
          "2026-10-12": {"value": 0, "quality": "ok", "outcome": {}, "tier": {}}
        },
        "keep_rate": {
          "2026-10-10": {"value": 0, "quality": "ok", "num": 0, "den": 1, "outcome": {"done": 1}, "tier": {"next": 1}},
          "2026-10-11": {"value": null, "quality": "missing", "outcome": {}, "tier": {}},
          "2026-10-12": {"value": null, "quality": "missing", "outcome": {}, "tier": {}}
        },
        "gaps": {"reviewed": [], "keep_rate": []}
      }
    },
