{
  "schema_version": 1,
  "contract": "docs/task-requirements.md §1–§2",
  "max_depth": 16,
  "cases": [
    {
      "id": "RQ1",
      "title": "depth-1 requirement with note, drawer, and log neighbours",
      "source_lines": [
        "- [ ] #task Ship the exporter ^export",
        "\t- ⛓️ **DEPENDS ON:** [[#^parser]]",
        "\t- [ ] Handles supported inputs",
        "\t\t- Fixture: windows.csv",
        "\t- NOTES",
        "\t\t- Morgan reported the original issue.",
        "\t- 🛠️ **WORK LOG**"
      ],
      "expect": {
        "nodes": [
          {
            "line": 3,
            "depth": 1,
            "parent": null,
            "owner": 1,
            "mark": "open",
            "state": "pending",
            "text": "Handles supported inputs",
            "anchor": null,
            "path": "1",
            "subtree_end": 4,
            "notes": [[4, 4]]
          }
        ],
        "probes": [
          {"line": 1, "owner": 1, "is_req": false},
          {"line": 2, "owner": null, "is_req": false},
          {"line": 3, "owner": 1, "is_req": true},
          {"line": 4, "owner": null, "is_req": false},
          {"line": 6, "owner": null, "is_req": false}
        ]
      }
    },
